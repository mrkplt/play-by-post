<% content_for :active_game_id, @scene_screen.game.id %>

<%= render Shared::MobileFrameComponent.new do |frame| %>
  <% frame.with_header do %>
    <%= render Shared::HeaderComponent.new(
          title: @scene_screen.scene.title,
          breadcrumbs: Shared::BreadcrumbsComponent.new(game_presenter: @scene_screen.game),
          secondary_nav: Shared::GameNavComponent.new(game_presenter: @scene_screen.game, active_tab: :scenes, mode: :link)) %>
  <% end %>

  <% if (page_action = @scene_screen.show.page_action(can_manage: @scene_screen.game.can_manage?)) %>
    <% frame.with_footer do %>
      <%= render Shared::PageActionsComponent.new do |actions| %>
        <% actions.with_primary do %>
          <%= render Ui::ButtonComponent.new(link: Ui::ButtonComponent::Link.new(url: page_action.href, method: page_action.http_method)) do %><%= page_action.label %><% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <div data-controller="ooc-filter"
       data-ooc-filter-hide-ooc-value="<%= @scene_screen.show.hide_ooc? %>"
       data-ooc-filter-toggle-url-value="<%= toggle_hide_ooc_profile_path %>">

    <%= render Shared::ControlRowComponent.new do %>
      <button type="button" data-action="click->ooc-filter#toggle"
              class="flex items-center gap-1.5 cursor-pointer bg-transparent border-0"
              aria-label="Toggle out-of-character posts">
        <span class="text-[11px] text-muted-2 font-semibold">Hide OOC</span>
        <span data-ooc-filter-target="switch">
          <%= render Ui::ToggleSwitchComponent.new(state: @scene_screen.show.hide_ooc? ? :on : :off) %>
        </span>
      </button>
    <% end %>

    <%# Scene meta / status %>
    <%= render Shared::StatusBadgeRowComponent.new(badges: @scene_screen.scene.status_badges) %>

    <% if @scene_screen.navigation.parent_scene? %>
      <p class="text-[11px] text-muted-2 m-0">
        &#8617; Continues from <%= link_to @scene_screen.navigation.parent_scene_title, @scene_screen.navigation.parent_scene_path, class: "text-accent" %>
      </p>
    <% end %>

    <% if @scene_screen.navigation.image_attached? %>
      <div>
        <%= image_tag @scene_screen.navigation.banner_image, class: "max-w-full rounded-card" %>
      </div>
    <% end %>

    <%= render Shared::ChildSceneListComponent.new(game: @scene_screen.game, child_scenes: @scene_screen.show.visible_child_scenes) %>

    <%= render Shared::ControlRowComponent.new(label: "Participants: #{@scene_screen.scene.participant_names}") do %>
      <%= render Ui::ButtonComponent.new(style: Ui::ButtonComponent::Style.new(variant: :text), link: Ui::ButtonComponent::Link.new(url: @scene_screen.navigation.toggle_notification_preference_path, method: :post)) do %><%= @scene_screen.show.mute_toggle_label %><% end %>
    <% end %>

    <% if @scene_screen.scene.resolved? && (resolution = @scene_screen.scene.resolution) %>
      <%= render Shared::SceneResolutionComponent.new(resolution: resolution) %>
    <% end %>

    <%# GM scene actions %>
    <% if @scene_screen.gm_actions? %>
      <div data-controller="resolve-toggle">
        <%= render Shared::ControlRowComponent.new do %>
          <%= render Ui::ButtonComponent.new(style: Ui::ButtonComponent::Style.new(variant: :text), link: Ui::ButtonComponent::Link.new(url: @scene_screen.navigation.quick_child_scene_path)) do %>Quick Scene<% end %>
          <%= render Ui::ButtonComponent.new(style: Ui::ButtonComponent::Style.new(variant: :text), link: Ui::ButtonComponent::Link.new(url: @scene_screen.navigation.new_child_scene_path)) do %>New Scene<% end %>
          <%= render Ui::ButtonComponent.new(style: Ui::ButtonComponent::Style.new(variant: :text), link: Ui::ButtonComponent::Link.new(url: @scene_screen.navigation.edit_participants_path)) do %>Edit Participants<% end %>
          <%= render Ui::ButtonComponent.new(style: Ui::ButtonComponent::Style.new(variant: :text), html_options: { class: "text-danger", data: { action: "click->resolve-toggle#toggle" } }) do %>End Scene<% end %>
        <% end %>
        <%= render Shared::SceneResolveFormComponent.new(resolve_path: @scene_screen.scene.resolve_path) %>
      </div>
    <% end %>

    <%# Posts %>
    <div id="posts" data-controller="unread-aura">
      <% if @scene_screen.posts.posts_empty? %>
        <p id="no_posts_message" class="text-muted-2 m-0 text-sm">No posts yet. Be the first!</p>
      <% else %>
        <% @scene_screen.posts.post_presenters.each do |post_presenter| %>
          <%= render Shared::PostItemComponent.new(
                post: post_presenter, scene: @scene_screen.scene, read_post_ids: @scene_screen.posts.read_post_ids) %>
        <% end %>
      <% end %>
    </div>

    <%# Scene summary %>
    <% if @scene_screen.summary? %>
      <%= render Shared::SceneSummaryComponent.new(summary: @scene_screen.summary) %>
    <% end %>

    <%= render Shared::DraftRecoveryComponent.new(game: @scene_screen.game, scene: @scene_screen.scene, draft: @scene_screen.posts.recoverable_draft(@scene_screen.posts.draft)) %>

    <%# Composer %>
    <% if @scene_screen.posts.can_post? %>
      <div id="post_composer" class="bg-card border border-card-border rounded-post p-4">
        <%= render Shared::PostComposerComponent.new(post: @scene_screen.posts.new_post, game: @scene_screen.game, scene: @scene_screen.scene, draft: @scene_screen.posts.draft) %>
      </div>
    <% end %>
  </div>
<% end %>
