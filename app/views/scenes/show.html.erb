<% content_for :active_game_id, @game.id %>

<div data-controller="ooc-filter"
     data-ooc-filter-hide-ooc-value="<%= @hide_ooc %>"
     data-ooc-filter-toggle-url-value="<%= toggle_hide_ooc_profile_path %>">
  <%= render Shared::MobileFrameComponent.new do |frame| %>
    <% frame.with_header do %>
      <header class="bg-sidebar-bg px-3 py-2 flex items-center gap-0.5">
        <%= render Ui::IconButtonComponent.new(href: game_path(@game), label: "Back to game") do %>
          <span class="text-2xl leading-none">&larr;</span>
        <% end %>
        <h1 class="text-white font-bold text-[15px] m-0 truncate flex-1"><%= @scene.title %></h1>
        <button type="button" data-action="click->ooc-filter#toggle"
                class="flex items-center gap-1.5 cursor-pointer bg-transparent border-0"
                aria-label="Toggle out-of-character posts">
          <span class="text-[11px] text-muted-2 font-semibold">Hide OOC</span>
          <span data-ooc-filter-target="switch">
            <%= render Ui::ToggleSwitchComponent.new(on: @hide_ooc) %>
          </span>
        </button>
      </header>
    <% end %>

    <%# Scene meta / status %>
    <div class="flex gap-1 flex-wrap">
      <% if @scene.private? %>
        <%= render(Ui::BadgeComponent.new(variant: :yellow)) { "Private" } %>
      <% end %>
      <% if @scene.resolved? %>
        <%= render(Ui::BadgeComponent.new(variant: :gray)) { "Resolved" } %>
      <% end %>
    </div>

    <% if @scene.parent_scene.present? %>
      <p class="text-[11px] text-muted-2 m-0">
        &#8617; Continues from <%= link_to @scene.parent_scene.title, game_scene_path(@game, @scene.parent_scene), class: "text-accent" %>
      </p>
    <% end %>

    <% if @scene.image.attached? %>
      <div>
        <%= image_tag @scene_presenter.banner_image, class: "max-w-full rounded-card" %>
      </div>
    <% end %>

    <% if @child_scenes.any? %>
      <p class="text-[11px] text-muted-2 m-0 flex flex-wrap gap-x-2">
        <% @child_scenes.each do |child| %>
          <span>&#10549; <%= link_to child.title, game_scene_path(@game, child), class: "text-accent" %></span>
        <% end %>
      </p>
    <% end %>

    <p class="text-[11px] text-muted-2 m-0">Participants: <%= @scene_presenter.participant_names %></p>

    <div>
      <%= button_to (@is_muted ? "Unmute notifications" : "Mute notifications"),
            toggle_notification_preference_game_scene_path(@game, @scene), method: :post,
            class: "text-[11px] font-semibold text-accent bg-transparent border-0 cursor-pointer p-0" %>
    </div>

    <% if @scene.resolved? && @scene.resolution.present? %>
      <div class="bg-tint-blue-bg border border-tint-blue-border rounded-card p-3 text-sm text-tint-blue-strong">
        <strong>Resolution:</strong> <%= @scene.resolution %>
      </div>
    <% end %>

    <%# GM scene actions %>
    <% if @is_gm && !@scene.resolved? %>
      <div class="flex flex-wrap gap-3">
        <%= link_to "Quick Scene", new_game_scene_path(@game, quick: true, parent_scene_id: @scene.id),
              class: "text-xs font-semibold text-accent no-underline" %>
        <%= link_to "New Scene", new_game_scene_path(@game, parent_scene_id: @scene.id),
              class: "text-xs font-semibold text-accent no-underline" %>
        <%= link_to "Edit Participants", edit_game_scene_participants_path(@game, @scene),
              class: "text-xs font-semibold text-accent no-underline" %>
        <button type="button" onclick="document.getElementById('resolve-form').hidden = !document.getElementById('resolve-form').hidden"
                class="text-xs font-semibold text-danger bg-transparent border-0 cursor-pointer p-0">End Scene</button>
      </div>
      <div id="resolve-form" hidden class="bg-card border border-card-border rounded-card p-3">
        <%= form_with url: resolve_game_scene_path(@game, @scene), method: :patch do |f| %>
          <%= f.label :resolution, "Outcome (optional)", class: "block text-sm font-semibold mb-1" %>
          <%= f.text_area :resolution, rows: 3, placeholder: "What happened? What was gained or lost?",
                class: "w-full px-3 py-2 border border-input-border rounded-control text-base" %>
          <%= f.submit "Confirm — End Scene", class: "mt-2 bg-card text-danger border border-red-200 rounded-control px-4 py-2 text-sm cursor-pointer" %>
        <% end %>
      </div>
    <% end %>

    <%# Posts %>
    <div id="posts" data-controller="unread-aura">
      <% if @posts.empty? %>
        <p id="no_posts_message" class="text-muted-2 m-0 text-sm">No posts yet. Be the first!</p>
      <% else %>
        <% @post_presenters.each do |post_presenter| %>
          <%= render Shared::PostItemComponent.new(
                post: post_presenter, game: @game, current_user: current_user,
                scene: @scene, read_post_ids: @read_post_ids) %>
        <% end %>
      <% end %>
    </div>

    <%# Join CTA %>
    <% if !@is_participant && !@is_gm && !@scene.private? && !@scene.resolved? && @current_membership&.active? %>
      <%= button_to "Join Scene", join_game_scene_participants_path(@game, @scene), method: :post,
            class: "w-full bg-accent text-accent-ink rounded-control py-2.5 font-bold text-sm cursor-pointer border-0" %>
    <% end %>

    <%# Scene summary %>
    <% if @scene.resolved? %>
      <% if @scene.scene_summary %>
        <%= render Shared::SceneSummaryComponent.new(
              summary: SceneSummaryPresenter.new(@scene.scene_summary), game: @game, scene: @scene, is_gm: @is_gm) %>
      <% elsif @is_gm %>
        <%= link_to "Write Summary", new_game_scene_scene_summary_path(@game, @scene),
              class: "block text-center bg-accent text-accent-ink rounded-control py-2.5 font-bold text-sm no-underline" %>
      <% end %>
    <% end %>

    <%# Draft recovery notice for resolved scenes %>
    <% if @scene.resolved? && @draft %>
      <div class="bg-tint-blue-bg border border-tint-blue-border rounded-card p-4">
        <p class="text-sm font-semibold text-tint-blue-strong mb-2">You have an unsaved draft from this scene.</p>
        <div class="markdown-base post-content text-sm text-body-ink mb-3 border border-tint-blue-border rounded-control p-3 bg-card"><%= render_markdown(@draft.content.to_s) %></div>
        <%= button_to "Discard Draft", discard_draft_game_scene_posts_path(@game, @scene), method: :delete,
              class: "text-xs font-semibold text-danger bg-transparent border-0 cursor-pointer p-0" %>
      </div>
    <% end %>

    <%# Composer %>
    <% if (@is_participant || @is_gm) && !@scene.resolved? && @game.member_for(current_user)&.active? %>
      <div id="post_composer" class="bg-card border border-card-border rounded-post p-4">
        <%= render Shared::PostComposerComponent.new(post: @post, game: @game, scene: @scene, draft: @draft) %>
      </div>
    <% end %>
  <% end %>
</div>
