<% content_for :active_game_id, @game_presenter.id %>

<%= render Shared::MobileFrameComponent.new do |frame| %>
  <% frame.with_header do %>
    <%= render Shared::HeaderComponent.new(
          title: @scene_presenter.title,
          breadcrumbs: Shared::BreadcrumbsComponent.new(game_presenter: @game_presenter),
          secondary_nav: Shared::GameNavComponent.new(game_presenter: @game_presenter, active_tab: :scenes, mode: :link)) %>
  <% end %>

  <% if (page_action = @scene_show.page_action(can_manage: @game_presenter.can_manage?)) %>
    <% frame.with_footer do %>
      <%= render Shared::PageActionsComponent.new do |actions| %>
        <% actions.with_primary do %>
          <%= render Ui::ButtonComponent.new(url: page_action.href, method: page_action.http_method) do %><%= page_action.label %><% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <div data-controller="ooc-filter"
       data-ooc-filter-hide-ooc-value="<%= @scene_show.hide_ooc? %>"
       data-ooc-filter-toggle-url-value="<%= toggle_hide_ooc_profile_path %>">

    <%= render Shared::ControlRowComponent.new do %>
      <button type="button" data-action="click->ooc-filter#toggle"
              class="flex items-center gap-1.5 cursor-pointer bg-transparent border-0"
              aria-label="Toggle out-of-character posts">
        <span class="text-[11px] text-muted-2 font-semibold">Hide OOC</span>
        <span data-ooc-filter-target="switch">
          <%= render Ui::ToggleSwitchComponent.new(on: @scene_show.hide_ooc?) %>
        </span>
      </button>
    <% end %>

    <%# Scene meta / status %>
    <%= render Shared::StatusBadgeRowComponent.new(badges: @scene_presenter.status_badges) %>

    <% if @scene_navigation_presenter.parent_scene? %>
      <p class="text-[11px] text-muted-2 m-0">
        &#8617; Continues from <%= link_to @scene_navigation_presenter.parent_scene_title, @scene_navigation_presenter.parent_scene_path, class: "text-accent" %>
      </p>
    <% end %>

    <% if @scene_navigation_presenter.image_attached? %>
      <div>
        <%= image_tag @scene_navigation_presenter.banner_image, class: "max-w-full rounded-card" %>
      </div>
    <% end %>

    <%= render Shared::ChildSceneListComponent.new(game: @game_presenter, child_scenes: @scene_show.visible_child_scenes) %>

    <%= render Shared::ControlRowComponent.new(label: "Participants: #{@scene_presenter.participant_names}") do %>
      <%= render Ui::ButtonComponent.new(variant: :text, url: @scene_navigation_presenter.toggle_notification_preference_path, method: :post) do %><%= @scene_show.mute_toggle_label %><% end %>
    <% end %>

    <% if @scene_presenter.resolved? && (resolution = @scene_presenter.resolution) %>
      <%= render Shared::SceneResolutionComponent.new(resolution: resolution) %>
    <% end %>

    <%# GM scene actions %>
    <% if @game_presenter.can_manage? && !@scene_presenter.resolved? %>
      <div data-controller="resolve-toggle">
        <%= render Shared::ControlRowComponent.new do %>
          <%= render Ui::ButtonComponent.new(variant: :text, url: @scene_navigation_presenter.quick_child_scene_path) do %>Quick Scene<% end %>
          <%= render Ui::ButtonComponent.new(variant: :text, url: @scene_navigation_presenter.new_child_scene_path) do %>New Scene<% end %>
          <%= render Ui::ButtonComponent.new(variant: :text, url: @scene_navigation_presenter.edit_participants_path) do %>Edit Participants<% end %>
          <%= render Ui::ButtonComponent.new(variant: :text, html_options: { class: "text-danger", data: { action: "click->resolve-toggle#toggle" } }) do %>End Scene<% end %>
        <% end %>
        <%= render Shared::SceneResolveFormComponent.new(resolve_path: @scene_presenter.resolve_path) %>
      </div>
    <% end %>

    <%# Posts %>
    <div id="posts" data-controller="unread-aura">
      <% if @scene_posts.posts_empty? %>
        <p id="no_posts_message" class="text-muted-2 m-0 text-sm">No posts yet. Be the first!</p>
      <% else %>
        <% @scene_posts.post_presenters.each do |post_presenter| %>
          <%= render Shared::PostItemComponent.new(
                post: post_presenter, scene: @scene_presenter, read_post_ids: @scene_posts.read_post_ids) %>
        <% end %>
      <% end %>
    </div>

    <%# Scene summary %>
    <% if @scene_presenter.resolved? && @scene_summary_presenter %>
      <%= render Shared::SceneSummaryComponent.new(summary: @scene_summary_presenter) %>
    <% end %>

    <%= render Shared::DraftRecoveryComponent.new(game: @game_presenter, scene: @scene_presenter, draft: @scene_posts.recoverable_draft(@scene_posts.draft)) %>

    <%# Composer %>
    <% if @scene_posts.can_post? %>
      <div id="post_composer" class="bg-card border border-card-border rounded-post p-4">
        <%= render Shared::PostComposerComponent.new(post: @scene_posts.new_post, game: @game_presenter, scene: @scene_presenter, draft: @scene_posts.draft) %>
      </div>
    <% end %>
  </div>
<% end %>
