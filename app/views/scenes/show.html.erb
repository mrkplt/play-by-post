<% content_for :active_game_id, @game.id %>

<%= render Shared::MobileFrameComponent.new do |frame| %>
  <% frame.with_header do %>
    <%= render Shared::HeaderComponent.new(
          title: @scene.title,
          breadcrumbs: Shared::BreadcrumbsComponent.new(game: @game),
          secondary_nav: Shared::GameNavComponent.new(game: @game, active_tab: :scenes, can_manage: @game_presenter.can_manage?, mode: :link)) %>
  <% end %>

  <% if (page_action = @scene_presenter.page_action(can_manage: @game_presenter.can_manage?, is_participant: @is_participant, membership: @current_membership)) %>
    <% frame.with_footer do %>
      <%= render Shared::PageActionsComponent.new do |actions| %>
        <% actions.with_primary do %>
          <%= render Ui::ButtonComponent.new(url: page_action.href, method: page_action.http_method) do %><%= page_action.label %><% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <div data-controller="ooc-filter"
       data-ooc-filter-hide-ooc-value="<%= @hide_ooc %>"
       data-ooc-filter-toggle-url-value="<%= toggle_hide_ooc_profile_path %>">

    <%= render Shared::ControlRowComponent.new do %>
      <button type="button" data-action="click->ooc-filter#toggle"
              class="flex items-center gap-1.5 cursor-pointer bg-transparent border-0"
              aria-label="Toggle out-of-character posts">
        <span class="text-[11px] text-muted-2 font-semibold">Hide OOC</span>
        <span data-ooc-filter-target="switch">
          <%= render Ui::ToggleSwitchComponent.new(on: @hide_ooc) %>
        </span>
      </button>
    <% end %>

    <%# Scene meta / status %>
    <%= render Shared::StatusBadgeRowComponent.new(badges: @scene_presenter.status_badges) %>

    <% if @scene.parent_scene.present? %>
      <p class="text-[11px] text-muted-2 m-0">
        &#8617; Continues from <%= link_to @scene.parent_scene.title, game_scene_path(@game, @scene.parent_scene), class: "text-accent" %>
      </p>
    <% end %>

    <% if @scene.image.attached? %>
      <div>
        <%= image_tag @scene_presenter.banner_image, class: "max-w-full rounded-card" %>
      </div>
    <% end %>

    <%= render Shared::ChildSceneListComponent.new(game: @game, child_scenes: @child_scenes.to_a) %>

    <%= render Shared::ControlRowComponent.new(label: "Participants: #{@scene_presenter.participant_names}") do %>
      <%= render Ui::ButtonComponent.new(variant: :text, url: toggle_notification_preference_game_scene_path(@game, @scene), method: :post) do %><%= @scene_presenter.mute_toggle_label(@is_muted) %><% end %>
    <% end %>

    <% if @scene.resolved? && @scene.resolution.present? %>
      <%= render Shared::SceneResolutionComponent.new(scene: @scene) %>
    <% end %>

    <%# GM scene actions %>
    <% if @game_presenter.can_manage? && !@scene.resolved? %>
      <div data-controller="resolve-toggle">
        <%= render Shared::ControlRowComponent.new do %>
          <%= render Ui::ButtonComponent.new(variant: :text, url: new_game_scene_path(@game, quick: true, parent_scene_id: @scene.id)) do %>Quick Scene<% end %>
          <%= render Ui::ButtonComponent.new(variant: :text, url: new_game_scene_path(@game, parent_scene_id: @scene.id)) do %>New Scene<% end %>
          <%= render Ui::ButtonComponent.new(variant: :text, url: edit_game_scene_participants_path(@game, @scene)) do %>Edit Participants<% end %>
          <%= render Ui::ButtonComponent.new(variant: :text, html_options: { class: "text-danger", data: { action: "click->resolve-toggle#toggle" } }) do %>End Scene<% end %>
        <% end %>
        <%= render Shared::SceneResolveFormComponent.new(game: @game, scene: @scene) %>
      </div>
    <% end %>

    <%# Posts %>
    <div id="posts" data-controller="unread-aura">
      <% if @posts.empty? %>
        <p id="no_posts_message" class="text-muted-2 m-0 text-sm">No posts yet. Be the first!</p>
      <% else %>
        <% @post_presenters.each do |post_presenter| %>
          <%= render Shared::PostItemComponent.new(
                post: post_presenter, scene: @scene_presenter, read_post_ids: @read_post_ids) %>
        <% end %>
      <% end %>
    </div>

    <%# Scene summary %>
    <% if @scene.resolved? && @scene.scene_summary %>
      <%= render Shared::SceneSummaryComponent.new(
            summary: SceneSummaryPresenter.new(@scene.scene_summary), game: @game, scene: @scene, can_manage: @game_presenter.can_manage?) %>
    <% end %>

    <%= render Shared::DraftRecoveryComponent.new(game: @game_presenter, scene: @scene_presenter, draft: @scene_presenter.recoverable_draft(@draft)) %>

    <%# Composer %>
    <% if @scene_presenter.can_post? %>
      <div id="post_composer" class="bg-card border border-card-border rounded-post p-4">
        <%= render Shared::PostComposerComponent.new(post: @post_presenter, game: @game_presenter, scene: @scene_presenter, draft: @draft_presenter) %>
      </div>
    <% end %>
  </div>
<% end %>
