<% content_for :active_game_id, @game.id %>

<%= render Shared::MobileFrameComponent.new do |frame| %>
  <% frame.with_header do %>
    <%= render Shared::HeaderComponent.new(
          title: "Edit — #{@notebook_entry.title}",
          breadcrumbs: Shared::BreadcrumbsComponent.new(game: @game),
          secondary_nav: Shared::GameNavComponent.new(game: @game, active_tab: :notebook, can_manage: true, mode: :link)) %>
  <% end %>

  <% frame.with_footer do %>
    <%= render Shared::PageActionsComponent.new do |actions| %>
      <% actions.with_primary do %>
        <%= render Ui::ButtonComponent.new(html_options: { type: "submit", form: "notebook_entry_#{@notebook_entry.id}_edit_form_element" }) do %>Save<% end %>
      <% end %>
      <% actions.with_cancel do %>
        <%= render Ui::ButtonComponent.new(variant: :secondary, url: game_notebook_entries_path(@game)) do %>Cancel<% end %>
      <% end %>
    <% end %>
  <% end %>

  <%= render Shared::NotebookEntryActionsComponent.new(game: @game, notebook_entry: @notebook_entry) %>
  <%= render Shared::NotebookFormComponent.new(game: @game, notebook_entry: @notebook_entry) %>
<% end %>
