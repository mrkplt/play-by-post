<% content_for :active_game_id, @game.id %>

<%= render Shared::MobileFrameComponent.new do |frame| %>
  <% frame.with_header do %>
    <%= render Shared::HeaderComponent.new(
          title: "Notebook",
          breadcrumbs: Shared::BreadcrumbsComponent.new(game: @game),
          secondary_nav: Shared::GameNavComponent.new(game: @game, active_tab: :notebook, can_manage: game_presenter.can_manage?, mode: :link)) %>
  <% end %>

  <%= render Shared::NotebookBoardComponent.new(game: game_presenter, board: @notebook_board) %>
<% end %>
