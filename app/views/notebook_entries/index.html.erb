<% content_for :active_game_id, @game.id %>

<%= render Shared::MobileFrameComponent.new do |frame| %>
  <% frame.with_header do %>
    <%= render Shared::HeaderComponent.new(
          title: "Notebook",
          breadcrumbs: Shared::BreadcrumbsComponent.new(game: @game),
          secondary_nav: Shared::GameNavComponent.new(game: @game, active_tab: :notebook, is_gm: true, mode: :link)) %>
  <% end %>

  <%= render Shared::NotebookBoardComponent.new(game: @game, entries_by_status: @entries.group_by(&:status)) %>
<% end %>
