<% content_for :active_game_id, @game.id %>

<%= render Shared::MobileFrameComponent.new do |frame| %>
  <% frame.with_header do %>
    <%= render Shared::HeaderComponent.new(
          title: "Links",
          breadcrumbs: Shared::BreadcrumbsComponent.new(game: @game),
          secondary_nav: Shared::GameNavComponent.new(game: @game, active_tab: :links, can_manage: @game_presenter.can_manage?, mode: :link)) %>
  <% end %>

  <%= render Shared::GameLinksListComponent.new(game: @game_presenter, game_links: @game_links, can_manage: @game_presenter.can_manage?) %>
<% end %>
