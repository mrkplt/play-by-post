<% content_for :active_game_id, @game_presenter.id %>

<%= render Shared::MobileFrameComponent.new do |frame| %>
  <% frame.with_header do %>
    <%= render Shared::HeaderComponent.new(
          title: "Edit — #{@game_link_presenter.description}",
          breadcrumbs: Shared::BreadcrumbsComponent.new(game_presenter: @game_presenter),
          secondary_nav: Shared::GameNavComponent.new(game_presenter: @game_presenter, active_tab: :links, mode: :link)) %>
  <% end %>

  <% frame.with_footer do %>
    <%= render Shared::PageActionsComponent.new do |actions| %>
      <% actions.with_primary do %>
        <%= render Ui::ButtonComponent.new(html_options: { type: "submit", form: "edit_game_link_#{@game_link_presenter.id}_form" }) do %>Save<% end %>
      <% end %>
      <% actions.with_cancel do %>
        <%= render Ui::ButtonComponent.new(style: Ui::ButtonComponent::Style.new(variant: :secondary), link: Ui::ButtonComponent::Link.new(url: game_game_links_path(@game_presenter))) do %>Cancel<% end %>
      <% end %>
    <% end %>
  <% end %>

  <%= render Shared::LinkFormComponent.new(game: @game_presenter, game_link: @game_link_presenter) %>
<% end %>
