<% content_for :active_game_id, @game.id %>

<%= render Shared::MobileFrameComponent.new do |frame| %>
  <% frame.with_header do %>
    <%= render Shared::HeaderComponent.new(
          title: "New Link",
          breadcrumbs: Shared::BreadcrumbsComponent.new(game: @game),
          secondary_nav: Shared::GameNavComponent.new(game: @game, active_tab: :links, can_manage: policy(@game).manage?, mode: :link)) %>
  <% end %>

  <% frame.with_footer do %>
    <%= render Shared::PageActionsComponent.new do |actions| %>
      <% actions.with_primary do %>
        <%= render Ui::ButtonComponent.new(html_options: { type: "submit", form: "new_game_link_form" }) do %>Create Link<% end %>
      <% end %>
      <% actions.with_cancel do %>
        <%= render Ui::ButtonComponent.new(variant: :secondary, url: game_game_links_path(@game)) do %>Cancel<% end %>
      <% end %>
    <% end %>
  <% end %>

  <%= render Shared::LinkFormComponent.new(game: @game, game_link: @game_link) %>
<% end %>
