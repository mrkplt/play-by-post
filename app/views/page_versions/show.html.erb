<% content_for :active_game_id, @game_presenter.id %>

<%= render Shared::MobileFrameComponent.new do |frame| %>
  <% frame.with_header do %>
    <%= render Shared::HeaderComponent.new(
          title: @page_presenter.title,
          breadcrumbs: Shared::BreadcrumbsComponent.new(game_presenter: @game_presenter),
          secondary_nav: Shared::GameNavComponent.new(game_presenter: @game_presenter, active_tab: :pages, mode: :link)) %>
  <% end %>

  <div class="flex flex-col gap-0.5">
    <span class="text-[11px] text-muted-2">
      Version — <time data-local-time="<%= @version_presenter.created_at_timestamp %>"><%= @version_presenter.formatted_created_at %></time>
    </span>
    <span class="text-[11px] text-muted-2">Edited by: <%= @version_presenter.editor_name %></span>
  </div>

  <div class="bg-card border border-card-border rounded-card p-4">
    <h1 class="text-lg font-bold text-ink m-0 mb-3"><%= @version_presenter.title %></h1>
    <% if @version_presenter.body? %>
      <%= render Ui::MarkdownRenderComponent.new(text: @version_presenter.body) %>
    <% else %>
      <p class="text-muted-2 m-0 text-sm">No content in this version.</p>
    <% end %>
  </div>
<% end %>
