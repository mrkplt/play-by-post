<p>
  Hi <%= @export.recipient_name %>,
</p>

<p>
  <% if (game = @export.game) %>
    Your export of <strong><%= game.name %></strong> is ready to download.
  <% else %>
    Your export of all your games is ready to download.
  <% end %>
</p>

<p>The archive includes scenes, posts, characters, and a game file manifest.</p>

<p style="margin: 1.5rem 0;">
  <%= link_to "Download Export", @export.download_url, style: mail_button_style %>
</p>

<p style="<%= mail_meta_style(size: "0.85em") %>">
  This link expires in <%= @export.expires_days %> days. After that, you can request a new export from the app.
</p>
