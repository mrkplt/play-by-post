<p>A scene in <strong><%= @game_presenter.name %></strong> has been resolved.</p>

<h2><%= @scene_notification.title %></h2>

<% if (resolution = @scene_notification.resolution) %>
  <p><strong>Outcome:</strong> <%= resolution %></p>
<% end %>

<p><%= link_to "View scene", @scene_notification.scene_url %></p>
