<% content_for :active_game_id, @game.id %>

<%= render Shared::MobileFrameComponent.new do |frame| %>
  <% frame.with_header do %>
    <%= render Shared::HeaderComponent.new(
          title: @character.name,
          breadcrumbs: Shared::BreadcrumbsComponent.new(game: @game),
          secondary_nav: Shared::GameNavComponent.new(game: @game, active_tab: :roster, can_manage: @character_presenter.can_manage_game?, mode: :link)) %>
  <% end %>

  <div class="flex flex-col gap-0.5">
    <span class="text-[11px] text-muted-2">
      Version — <time data-local-time="<%= @version_presenter.created_at_iso8601 %>"><%= @version_presenter.created_at_label %></time>
    </span>
    <span class="text-[11px] text-muted-2">Edited by: <%= @editor.display_name_or_email %></span>
  </div>

  <div class="bg-card border border-card-border rounded-card p-4">
    <% if @version_presenter.content? %>
      <%= render Ui::MarkdownRenderComponent.new(text: @version_presenter.content, content_class: "character-sheet-content") %>
    <% else %>
      <p class="text-muted-2 m-0 text-sm">No content in this version.</p>
    <% end %>
  </div>
<% end %>
