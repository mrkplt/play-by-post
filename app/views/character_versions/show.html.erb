<% content_for :active_game_id, @game.id %>

<%= render Shared::MobileFrameComponent.new do |frame| %>
  <% frame.with_header do %>
    <%= render Shared::PageHeaderComponent.new(title: @character.name, leading: :back, back_href: game_character_path(@game, @character)) %>
  <% end %>

  <div class="flex flex-col gap-0.5">
    <span class="text-[11px] text-muted-2">
      Version — <time data-local-time="<%= @version.created_at.iso8601 %>"><%= @version.created_at.strftime("%b %-d, %Y %-I:%M %p") %></time>
    </span>
    <span class="text-[11px] text-muted-2">Edited by: <%= @editor.display_name_or_email %></span>
  </div>

  <div class="bg-card border border-card-border rounded-card p-4">
    <% if @version.content.present? %>
      <%= render Ui::MarkdownRenderComponent.new(text: @version.content, content_class: "character-sheet-content") %>
    <% else %>
      <p class="text-muted-2 m-0 text-sm">No content in this version.</p>
    <% end %>
  </div>
<% end %>
