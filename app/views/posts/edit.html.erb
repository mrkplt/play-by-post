<% content_for :active_game_id, @game.id %>

<%= render Shared::MobileFrameComponent.new do |frame| %>
  <% frame.with_header do %>
    <%= render Shared::PageHeaderComponent.new(title: "Edit Post", leading: :back, back_href: game_scene_path(@game, @scene)) %>
  <% end %>

  <%= render Shared::PostEditFormComponent.new(game: @game, scene: @scene, post: @post) %>
<% end %>
