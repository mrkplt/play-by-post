<%= turbo_stream.remove "no_posts_message" %>
<%= turbo_stream.append "posts" do %>
  <%= render Shared::PostItemComponent.new(
        post: @post_presenter,
        scene: @scene_presenter
      ) %>
<% end %>
<%= turbo_stream.replace "post_composer" do %>
  <%= render Shared::PostComposerComponent.new(post: PostPresenter.new(Post.new), game: @game_presenter, scene: @scene_presenter) %>
<% end %>
