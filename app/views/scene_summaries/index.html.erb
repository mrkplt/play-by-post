<% content_for :active_game_id, @game.id %>

<%= render Shared::MobileFrameComponent.new do |frame| %>
  <% frame.with_header do %>
    <%= render Shared::HeaderComponent.new(
          title: "Campaign Log",
          breadcrumbs: Shared::BreadcrumbsComponent.new(game: @game),
          secondary_nav: Shared::GameNavComponent.new(game: @game, active_tab: :scenes, can_manage: @game_presenter.can_manage?, mode: :link)) %>
  <% end %>

  <% frame.with_footer do %>
    <%= render Shared::PageActionsComponent.new do |actions| %>
      <% if @game_presenter.can_manage? %>
        <% actions.with_cancel do %>
          <%= render Ui::ButtonComponent.new(variant: :secondary, url: edit_game_path(@game)) do %>Edit Game<% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <%= render Shared::SceneSummaryIndexPageComponent.new(game: @game, summaries: @summaries, pagy: @pagy) %>
<% end %>
