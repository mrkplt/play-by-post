<%# Polled frame for the async scene summary (Fizzy #115). Same frame id as the
    scene page's initial pending render, so a poll response replaces it in place.
    While pending it is the spinner; once a visible summary exists it becomes the
    summary. The completion toast rides INSIDE the ready frame as a
    <turbo-stream> — Turbo runs any stream element the moment it connects to the
    DOM, so appending it to the frame content lands it in #toast_layer even
    though a frame navigation ignores sibling streams. %>
<%= render Shared::AsyncPendingComponent.new(
      frame_id: "scene_summary_pending",
      poll_path: status_poll_path,
      ready: @summary_presenter.present?,
      message: Shared::SceneSummaryComponent::PENDING_MESSAGE) do |pending| %>
  <% if @summary_presenter %>
    <% pending.with_ready do %>
      <%= render Shared::SceneSummaryComponent.new(summary: @summary_presenter) %>
      <%= turbo_stream.replace "toast_layer" do %>
        <%= render Ui::ToastComponent.new(toasts: FlashPresenter.new(flash).toasts) %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
