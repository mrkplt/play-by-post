<% content_for :active_game_id, @game_screen.game.id %>

<%= render Shared::GameTabsComponent.new do %>
  <%= render Shared::MobileFrameComponent.new do |frame| %>
    <% frame.with_header do %>
      <%= render Shared::HeaderComponent.new(
            title: Shared::HeaderComponent::Title.new(text: @game_screen.game.name, crown: @game_screen.game.can_manage?),
            gear: game_player_management_path(@game_screen.game),
            secondary_nav: Shared::GameNavComponent.new(game_presenter: @game_screen.game, active_tab: :scenes, mode: :switch)) %>
    <% end %>

    <%# ===== Scenes panel ===== %>
    <%= render Shared::GameTabsComponent::PanelComponent.new(name: "scenes", visibility: :shown) do %>
      <%= render Ui::SectionLabelComponent.new do %>Active Scenes<% end %>
      <% unless @game_screen.scenes.active_scenes? %>
        <p class="text-muted-2 text-sm">No active scenes.</p>
      <% else %>
        <div>
          <% @game_screen.scenes.active_scenes.each do |scene| %>
            <%= render Shared::SceneCardComponent.new(scene: scene, game: @game_screen.game) %>
          <% end %>
        </div>
      <% end %>

      <% if @game_screen.game.can_manage? %>
        <%= link_to "New Scene", new_game_scene_path(@game_screen.game),
              class: "block w-full text-center bg-accent text-accent-ink rounded-control py-2.5 font-bold text-[13px] no-underline" %>
      <% end %>

      <%= link_to "View all scenes", game_scenes_path(@game_screen.game),
            class: "block w-full text-center text-accent rounded-control py-2 font-bold text-[13px] no-underline" %>

      <%= render Ui::SectionLabelComponent.new(html_class: "mt-2") do %>In Active Scenes<% end %>
      <div class="bg-card border border-card-border rounded-card overflow-hidden">
        <%# The crown marks the person this row is about, not the viewer: this
            row IS the GM, so it is always crowned. %>
        <%= render Shared::RosterRowComponent.new(
              row: { name: @game_screen.scenes.gm_name, subtitle: "Running this game",
                     avatar_tone: :dark, crown: true, avatar_url: @game_screen.scenes.gm_avatar_url },
              position: @game_screen.scenes.gm_row_position) %>
        <% @game_screen.scenes.roster_preview.each_with_index do |row, i| %>
          <%= render Shared::RosterRowComponent.new(
                row: { name: row[:name], subtitle: row[:scene], avatar_tone: :gold, avatar_url: row[:avatar_url] },
                position: @game_screen.scenes.roster_preview_position(i)) %>
        <% end %>
      </div>
    <% end %>

    <%# ===== Roster panel ===== %>
    <%= render Shared::GameTabsComponent::PanelComponent.new(name: "roster") do %>
      <%= render Shared::RosterFilterComponent.new(
            roster: @game_screen.roster,
            new_character_path: new_game_character_path(@game_screen.game)) %>

      <% if @game_screen.roster.banned_members_section? %>
        <%= render Ui::SectionLabelComponent.new(html_class: "mt-3") do %>Banned &middot; GM only<% end %>
        <div class="bg-tint-blue-bg border border-tint-blue-border rounded-card overflow-hidden opacity-85 mt-1">
          <% @game_screen.roster.banned_members.each_with_index do |banned, i| %>
            <%= render Shared::RosterRowComponent.new(
                  row: { name: banned.display_name, subtitle: "Played by #{banned.display_name}",
                         avatar_tone: :blue, variant: :blue, avatar_url: banned.avatar_url },
                  position: @game_screen.roster.banned_member_position(i)) do %>
              <%= form_with url: banned.unban_path, method: :patch, class: "inline" do |f| %>
                <%= f.hidden_field :status, value: "active" %>
                <%= f.submit "Unban", class: "text-[11px] font-bold text-danger-soft bg-transparent border-0 cursor-pointer p-0" %>
              <% end %>
            <% end %>
          <% end %>
        </div>
      <% end %>

      <% if @game_screen.game.can_manage? %>
        <%= render Shared::InvitePanelComponent.new(game: @game_screen.game, pending_invitations: @game_screen.show.pending_invitations) %>
      <% end %>
    <% end %>

    <%# ===== Files panel ===== %>
    <%= render Shared::GameTabsComponent::PanelComponent.new(name: "files") do %>
      <% if @game_screen.game.can_manage? %>
        <%= render Shared::FileUploadFormComponent.new(game: @game_screen.game, game_file: @game_screen.show.new_game_file) %>
      <% end %>
      <% unless @game_screen.show.game_files? %>
        <p class="text-muted-2 text-sm">No files uploaded yet.</p>
      <% else %>
        <%= render Ui::SectionLabelComponent.new do %>Newest first<% end %>
        <%= render Shared::GalleryComponent.new(game_files: @game_screen.show.game_files) %>
      <% end %>
    <% end %>

    <%# ===== Pages panel ===== %>
    <%= render Shared::GameTabsComponent::PanelComponent.new(name: "pages") do %>
      <%= render Shared::GamePagesListComponent.new(game: @game_screen.game, pages: @game_screen.show.pages, can_manage: @game_screen.game.can_manage?) %>
    <% end %>

    <%# ===== Links panel ===== %>
    <%= render Shared::GameTabsComponent::PanelComponent.new(name: "links") do %>
      <%= render Shared::GameLinksListComponent.new(game: @game_screen.game, game_links: @game_screen.show.links, can_manage: @game_screen.game.can_manage?) %>
    <% end %>

    <%# ===== Notebook panel (GM only) ===== %>
    <% if @game_screen.game.can_manage? %>
      <%= render Shared::GameTabsComponent::PanelComponent.new(name: "notebook") do %>
        <%= render Shared::NotebookBoardComponent.new(game: @game_screen.game, board: @game_screen.game.notebook_board) %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
