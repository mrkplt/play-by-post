<% content_for :active_game_id, @game_presenter.id %>

<div data-controller="game-tabs">
  <%= render Shared::MobileFrameComponent.new do |frame| %>
    <% frame.with_header do %>
      <%= render Shared::HeaderComponent.new(
            title: @game_presenter.name,
            crown: @game_presenter.can_manage?,
            gear: game_player_management_path(@game_presenter),
            secondary_nav: Shared::GameNavComponent.new(game_presenter: @game_presenter, active_tab: :scenes, mode: :switch)) %>
    <% end %>

    <%# ===== Scenes panel ===== %>
    <section data-game-tabs-target="panel" data-panel="scenes" class="flex flex-col gap-3">
      <%= render Ui::SectionLabelComponent.new do %>Active Scenes<% end %>
      <% unless @game_scenes.active_scenes? %>
        <p class="text-muted-2 text-sm">No active scenes.</p>
      <% else %>
        <div>
          <% @game_scenes.active_scenes.each do |scene| %>
            <%= render Shared::SceneCardComponent.new(scene: scene, game: @game_presenter, hot: scene.hot?) %>
          <% end %>
        </div>
      <% end %>

      <% if @game_presenter.can_manage? %>
        <%= link_to "New Scene", new_game_scene_path(@game_presenter),
              class: "block w-full text-center bg-accent text-accent-ink rounded-control py-2.5 font-bold text-[13px] no-underline" %>
      <% end %>

      <%= link_to "View all scenes", game_scenes_path(@game_presenter),
            class: "block w-full text-center text-accent rounded-control py-2 font-bold text-[13px] no-underline" %>

      <%= render Ui::SectionLabelComponent.new(html_class: "mt-2") do %>In Active Scenes<% end %>
      <div class="bg-card border border-card-border rounded-card overflow-hidden">
        <%# The crown marks the person this row is about, not the viewer: this
            row IS the GM, so it is always crowned. %>
        <%= render Shared::RosterRowComponent.new(
              name: @game_scenes.gm_name, subtitle: "Running this game",
              avatar_tone: :dark, crown: true, last: @game_scenes.gm_row_last?) %>
        <% @game_scenes.roster_preview.each_with_index do |row, i| %>
          <%= render Shared::RosterRowComponent.new(
                name: row[:name], subtitle: row[:scene],
                avatar_tone: :gold, last: @game_scenes.roster_preview_last?(i)) %>
        <% end %>
      </div>
    </section>

    <%# ===== Roster panel ===== %>
    <section data-game-tabs-target="panel" data-panel="roster" class="flex flex-col gap-3" hidden>
      <div data-controller="roster-filter">
        <div class="flex items-center gap-1.5 border border-input-border rounded-control px-2.5 py-2 bg-card mb-3">
          <span class="text-[13px] text-muted-2">&#128269;</span>
          <input type="text" placeholder="Search characters or players"
                 data-roster-filter-target="query" data-action="input->roster-filter#filter"
                 class="flex-1 text-[13px] text-ink bg-transparent border-0 outline-none placeholder:text-muted-2">
        </div>

        <div class="flex items-center justify-between">
          <%= render Ui::SectionLabelComponent.new do %>Characters<% end %>
          <%= link_to "New Character", new_game_character_path(@game_presenter), class: "text-[11px] font-bold text-accent no-underline" %>
        </div>
        <% unless @game_roster.roster_characters? %>
          <p class="text-muted-2 text-sm">No characters yet.</p>
        <% else %>
          <div class="bg-card border border-card-border rounded-card overflow-hidden mt-1">
            <% @game_roster.roster_characters.each_with_index do |row, i| %>
              <div data-roster-filter-target="row" data-roster-name="<%= row.filter_key %>">
                <%= render Shared::RosterRowComponent.new(
                      name: row.character_name,
                      subtitle: "Played by #{row.owner_name}",
                      avatar_tone: row.avatar_tone,
                      dimmed: row.removed?,
                      last: @game_roster.roster_character_last?(i)) do %>
                  <% if row.removed? %>
                    <%= render(Ui::BadgeComponent.new(variant: :slate)) { "Removed" } %>
                  <% end %>
                <% end %>
              </div>
            <% end %>
          </div>
        <% end %>

        <% if @game_roster.inactive_characters? %>
          <p class="text-[11px] text-muted-2 text-center mt-3">
            <%= pluralize(@game_roster.inactive_character_count, "inactive character") %> hidden
          </p>
        <% end %>

        <% if @game_roster.banned_members_section? %>
          <%= render Ui::SectionLabelComponent.new(html_class: "mt-3") do %>Banned &middot; GM only<% end %>
          <div class="bg-tint-blue-bg border border-tint-blue-border rounded-card overflow-hidden opacity-85 mt-1">
            <% @game_roster.banned_members.each_with_index do |banned, i| %>
              <%= render Shared::RosterRowComponent.new(
                    name: banned.display_name,
                    subtitle: "Played by #{banned.display_name}",
                    avatar_tone: :blue,
                    name_class: "text-tint-blue-strong",
                    subtitle_class: "text-tint-blue-soft",
                    last: @game_roster.banned_member_last?(i)) do %>
                <%= form_with url: banned.unban_path, method: :patch, class: "inline" do |f| %>
                  <%= f.hidden_field :status, value: "active" %>
                  <%= f.submit "Unban", class: "text-[11px] font-bold text-danger-soft bg-transparent border-0 cursor-pointer p-0" %>
                <% end %>
              <% end %>
            <% end %>
          </div>
        <% end %>

        <% if @game_presenter.can_manage? %>
          <%= render Shared::InvitePanelComponent.new(game: @game_presenter, pending_invitations: @game_show.pending_invitations) %>
        <% end %>
      </div>
    </section>

    <%# ===== Files panel ===== %>
    <section data-game-tabs-target="panel" data-panel="files" class="flex flex-col gap-3" hidden>
      <% if @game_presenter.can_manage? %>
        <%= render Shared::FileUploadFormComponent.new(game: @game_presenter, game_file: @game_show.new_game_file) %>
      <% end %>
      <% unless @game_show.game_files? %>
        <p class="text-muted-2 text-sm">No files uploaded yet.</p>
      <% else %>
        <%= render Ui::SectionLabelComponent.new do %>Newest first<% end %>
        <%= render Shared::GalleryComponent.new(game_files: @game_show.game_files, can_manage: @game_presenter.can_manage?) %>
      <% end %>
    </section>

    <%# ===== Pages panel ===== %>
    <section data-game-tabs-target="panel" data-panel="pages" hidden>
      <%= render Shared::GamePagesListComponent.new(game: @game_presenter, pages: @game_show.pages, can_manage: @game_presenter.can_manage?) %>
    </section>

    <%# ===== Links panel ===== %>
    <section data-game-tabs-target="panel" data-panel="links" hidden>
      <%= render Shared::GameLinksListComponent.new(game: @game_presenter, game_links: @game_show.links, can_manage: @game_presenter.can_manage?) %>
    </section>

    <%# ===== Notebook panel (GM only) ===== %>
    <% if @game_presenter.can_manage? %>
      <section data-game-tabs-target="panel" data-panel="notebook" hidden>
        <%= render Shared::NotebookBoardComponent.new(game: @game_presenter, board: @game_presenter.notebook_board) %>
      </section>
    <% end %>
  <% end %>
</div>
