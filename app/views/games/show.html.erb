<% content_for :active_game_id, @game.id %>

<div data-controller="game-tabs">
  <%= render Shared::MobileFrameComponent.new do |frame| %>
    <% frame.with_header do %>
      <%= render Shared::GameHeaderComponent.new(
            game: @game, title: @game.name, is_gm: @is_gm, active_tab: :scenes, show_gear: true) %>
    <% end %>

    <%# ===== Scenes panel ===== %>
    <section data-game-tabs-target="panel" data-panel="scenes" class="flex flex-col gap-3">
      <%= render Ui::SectionLabelComponent.new do %>Active Scenes<% end %>
      <% if @active_scenes.empty? %>
        <p class="text-muted-2 text-sm">No active scenes.</p>
      <% else %>
        <div>
          <% @active_scenes.each do |scene| %>
            <%= render Shared::SceneCardComponent.new(scene: scene, game: @game, hot: @hot_scene_ids.include?(scene.id)) %>
          <% end %>
        </div>
      <% end %>

      <% if @is_gm %>
        <%= link_to "New Scene", new_game_scene_path(@game),
              class: "block w-full text-center bg-accent text-accent-ink rounded-control py-2.5 font-bold text-[13px] no-underline" %>
      <% end %>

      <%= render Ui::SectionLabelComponent.new(html_class: "mt-2") do %>In Active Scenes<% end %>
      <div class="bg-card border border-card-border rounded-card overflow-hidden">
        <%= render Shared::RosterRowComponent.new(
              name: @gm_name, subtitle: "Running this game",
              avatar_tone: :dark, crown: @is_gm, last: @roster_preview.empty?) %>
        <% @roster_preview.each_with_index do |row, i| %>
          <%= render Shared::RosterRowComponent.new(
                name: row[:name], subtitle: row[:scene],
                avatar_tone: :gold, last: i == @roster_preview.length - 1) %>
        <% end %>
      </div>

      <%= render Ui::SectionLabelComponent.new(html_class: "mt-2") do %>Export<% end %>
      <div class="bg-card border border-card-border rounded-card px-3.5">
        <%= render Ui::SettingsRowComponent.new(label: "This game", sub: @export_notice, last: true) do %>
          <%= button_to "Export Game", game_export_path(@game), method: :post,
                class: "text-[11px] font-bold text-accent bg-transparent border-0 cursor-pointer p-0" %>
        <% end %>
      </div>
    </section>

    <%# ===== Roster panel ===== %>
    <section data-game-tabs-target="panel" data-panel="roster" class="flex flex-col gap-3" hidden>
      <div data-controller="roster-filter">
        <div class="flex items-center gap-1.5 border border-[#d8d5cd] rounded-control px-2.5 py-2 bg-card mb-3">
          <span class="text-[13px] text-muted-2">&#128269;</span>
          <input type="text" placeholder="Search characters or players"
                 data-roster-filter-target="query" data-action="input->roster-filter#filter"
                 class="flex-1 text-[13px] text-ink bg-transparent border-0 outline-none placeholder:text-muted-2">
        </div>

        <div class="flex items-center justify-between">
          <%= render Ui::SectionLabelComponent.new do %>Characters<% end %>
          <%= link_to "New Character", new_game_character_path(@game), class: "text-[11px] font-bold text-accent no-underline" %>
        </div>
        <% if @roster_characters.empty? %>
          <p class="text-muted-2 text-sm">No characters yet.</p>
        <% else %>
          <div class="bg-card border border-card-border rounded-card overflow-hidden mt-1">
            <% @roster_characters.each_with_index do |row, i| %>
              <div data-roster-filter-target="row" data-roster-name="<%= row[:filter_key] %>">
                <%= render Shared::RosterRowComponent.new(
                      name: row[:character].name,
                      subtitle: "Played by #{row[:owner_name]}",
                      avatar_tone: row[:avatar_tone],
                      dimmed: row[:removed],
                      last: i == @roster_characters.length - 1) do %>
                  <% if row[:removed] %>
                    <%= render Ui::BadgeComponent.new(variant: :slate) { "Removed" } %>
                  <% end %>
                <% end %>
              </div>
            <% end %>
          </div>
        <% end %>

        <% if @inactive_count.positive? %>
          <p class="text-[11px] text-muted-2 text-center mt-3">
            <%= pluralize(@inactive_count, "inactive character") %> hidden
          </p>
        <% end %>

        <% if @is_gm && @banned_members.any? %>
          <%= render Ui::SectionLabelComponent.new(html_class: "mt-3") do %>Banned &middot; GM only<% end %>
          <div class="bg-tint-blue-bg border border-tint-blue-border rounded-card overflow-hidden opacity-85 mt-1">
            <% @banned_members.each_with_index do |member, i| %>
              <%= render Shared::RosterRowComponent.new(
                    name: @banned_names[member.user_id],
                    subtitle: "Played by #{@banned_names[member.user_id]}",
                    avatar_tone: :blue,
                    name_class: "text-tint-blue-strong",
                    subtitle_class: "text-tint-blue-soft",
                    last: i == @banned_members.length - 1) do %>
                <%= form_with url: game_player_management_game_member_path(@game, member), method: :patch, class: "inline" do |f| %>
                  <%= f.hidden_field :status, value: "active" %>
                  <%= f.submit "Unban", class: "text-[11px] font-bold text-danger-soft bg-transparent border-0 cursor-pointer p-0" %>
                <% end %>
              <% end %>
            <% end %>
          </div>
        <% end %>

        <% if @is_gm %>
          <%= link_to "Invite Player", game_player_management_path(@game),
                class: "block w-full text-center bg-accent text-accent-ink rounded-control py-2.5 font-extrabold text-[13px] tracking-[0.02em] no-underline mt-3" %>
        <% end %>
      </div>
    </section>

    <%# ===== Files panel ===== %>
    <section data-game-tabs-target="panel" data-panel="files" class="flex flex-col gap-3" hidden>
      <% if @is_gm %>
        <%= render Shared::FileUploadFormComponent.new(game: @game, game_file: @game_file) %>
      <% end %>
      <% if @game_files.empty? %>
        <p class="text-muted-2 text-sm">No files uploaded yet.</p>
      <% else %>
        <%= render Ui::SectionLabelComponent.new do %>Newest first<% end %>
        <%= render Shared::GalleryComponent.new(game_files: @game_files.to_a, game: @game, is_gm: @is_gm) %>
      <% end %>
    </section>
  <% end %>
</div>
