<%= render Shared::MobileFrameComponent.new do |frame| %>
  <% frame.with_header do %>
    <%= render Shared::PageHeaderComponent.new(title: "New Game", leading: :back, back_href: root_path) %>
  <% end %>

  <%= render Shared::GameFormComponent.new(
        game: @game,
        submit_label: "Create game",
        cancel_href: root_path,
        note: "You will become the Game Master of this game.",
        confirm: "Create this game? You will be the GM.") %>
<% end %>
