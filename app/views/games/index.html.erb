<%= render Shared::MobileFrameComponent.new do |frame| %>
  <% frame.with_header do %>
    <%= render Shared::PageHeaderComponent.new(title: "Your Games", accent_title: true) %>
  <% end %>

  <% frame.with_footer do %>
    <%= link_to "+ New Game", new_game_path,
          class: "block w-full text-center bg-accent text-accent-ink rounded-control py-2.5 font-bold text-[13px] no-underline" %>
  <% end %>

  <% if @dashboard_items.empty? %>
    <div class="bg-card border border-card-border rounded-card p-5 text-center text-muted">
      <p class="text-base mb-2">You're not in any games yet.</p>
      <p class="mb-4 text-sm">Create a new game to get started, or ask a Game Master to invite you.</p>
    </div>
  <% else %>
    <% @dashboard_items.each do |item| %>
      <%= render Shared::GameCardComponent.new(
            game: item[:game],
            is_gm: item[:is_gm],
            former: item[:former],
            character_label: item[:character_label],
            active_scene_count: item[:active_scene_count],
            new_activity: item[:new_activity]
          ) %>
    <% end %>
  <% end %>
<% end %>
