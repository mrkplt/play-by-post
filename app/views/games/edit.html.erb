<% content_for :active_game_id, @game_presenter.id %>

<%= render Shared::MobileFrameComponent.new do |frame| %>
  <% frame.with_header do %>
    <%= render Shared::HeaderComponent.new(
          title: "Edit Game",
          breadcrumbs: Shared::BreadcrumbsComponent.new(game_presenter: @game_presenter)) %>
  <% end %>

  <%= render Ui::SectionLabelComponent.new do %>Game Details<% end %>
  <%= render Shared::GameFormComponent.new(
        game: @game_presenter,
        submission: Shared::GameFormComponent::Submission.new(label: "Save Changes", cancel_href: game_path(@game_presenter))) %>

  <%= render Ui::SectionLabelComponent.new(html_class: "mt-2") do %>Post Images<% end %>
  <%= render Ui::CardComponent.new do %>
    <%= render Shared::ImagesToggleComponent.new(game: @game_presenter) %>
  <% end %>

  <%= render Ui::SectionLabelComponent.new(html_class: "mt-2") do %>Character Sheets<% end %>
  <%= render Ui::CardComponent.new do %>
    <%= render Shared::SheetsToggleComponent.new(game: @game_presenter) %>
  <% end %>

  <%= render Shared::AiSummariesToggleComponent.new(game: @game_presenter) %>

  <%= render Ui::SectionLabelComponent.new(html_class: "mt-2") do %>Players<% end %>
  <%= render Ui::CardComponent.new do %>
    <%= render Ui::SettingsRowComponent.new(
          label: "Players & Invitations", sub: "Manage who can play and send invites", position: :last) do %>
      <%= link_to "Manage Players", game_player_management_path(@game_presenter),
            class: "text-[11px] font-bold text-accent no-underline" %>
    <% end %>
  <% end %>

  <%= render Ui::SectionLabelComponent.new(html_class: "mt-2") do %>Content Templates<% end %>
  <%= render Ui::CardComponent.new do %>
    <%= render Ui::SettingsRowComponent.new(
          label: "Templates", sub: "Pre-fill new pages, notes, and characters", position: :last) do %>
      <%= link_to "Manage Templates", game_content_templates_path(@game_presenter),
            class: "text-[11px] font-bold text-accent no-underline" %>
    <% end %>
  <% end %>
<% end %>
