<% content_for :active_game_id, @game.id %>

<%= render Shared::MobileFrameComponent.new do |frame| %>
  <% frame.with_header do %>
    <%= render Shared::PageHeaderComponent.new(title: "Edit — #{@page.title}", leading: :back, back_href: game_page_path(@game, @page)) %>
  <% end %>

  <%= render Shared::PageFormComponent.new(game: @game, page: @page) %>
<% end %>
