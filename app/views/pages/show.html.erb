<% content_for :active_game_id, @game.id %>

<%= render Shared::MobileFrameComponent.new do |frame| %>
  <% frame.with_header do %>
    <%= render Shared::HeaderComponent.new(
          title: @page_presenter.title,
          breadcrumbs: Shared::BreadcrumbsComponent.new(game: @game),
          secondary_nav: Shared::GameNavComponent.new(game: @game, active_tab: :pages, can_manage: @page_presenter.can_manage_game?, mode: :link)) %>
  <% end %>

  <%= render Shared::PageDetailComponent.new(game: @game_presenter, page: @page_presenter, can_manage: @page_presenter.can_manage?) %>
<% end %>
