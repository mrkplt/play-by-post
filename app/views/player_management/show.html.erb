<% content_for :active_game_id, @game_presenter.id %>

<%= render Shared::MobileFrameComponent.new do |frame| %>
  <% frame.with_header do %>
    <%= render Shared::HeaderComponent.new(
          title: "Game Settings",
          breadcrumbs: Shared::BreadcrumbsComponent.new(game_presenter: @game_presenter)) %>
  <% end %>

  <% if @game_presenter.can_manage? %>
    <%# Game Details %>
    <%= render Shared::GameDetailsComponent.new(game: @game_presenter) %>

    <%# Members %>
    <%= render Ui::SectionLabelComponent.new(html_class: "mt-2") do %>Members<% end %>
    <% if @roster.empty? %>
      <p class="text-muted-2 text-sm">No players yet.</p>
    <% else %>
      <div class="bg-card border border-card-border rounded-card px-3.5">
        <% @roster.each_with_index do |member, i| %>
          <%= render Ui::SettingsRowComponent.new(
                label: member.display_name,
                sub: member.character_name,
                position: i == @roster.length - 1 ? :last : :middle) do %>
            <% if member.active? %>
              <%= render Ui::ButtonComponent.new(style: Ui::ButtonComponent::Style.new(variant: :text_muted), link: Ui::ButtonComponent::Link.new(url: game_player_management_game_member_path(@game_presenter, member, status: "removed"), method: :patch, confirm: "Remove this player? They keep read-only access.")) do %>Remove<% end %>
              <%= render Ui::ButtonComponent.new(style: Ui::ButtonComponent::Style.new(variant: :text_danger), link: Ui::ButtonComponent::Link.new(url: game_player_management_game_member_path(@game_presenter, member, status: "banned"), method: :patch, confirm: "Ban this player? This permanently revokes all access and cannot be undone easily.")) do %>Ban<% end %>
            <% elsif member.removed? %>
              <%= render Ui::ButtonComponent.new(style: Ui::ButtonComponent::Style.new(variant: :text), link: Ui::ButtonComponent::Link.new(url: game_player_management_game_member_path(@game_presenter, member, status: "active"), method: :patch)) do %>Reinstate<% end %>
            <% end %>
          <% end %>
        <% end %>
      </div>
    <% end %>

    <%# Game Preferences %>
    <%= render Ui::SectionLabelComponent.new(html_class: "mt-2") do %>Game Preferences<% end %>
    <div class="bg-card border border-card-border rounded-card px-3.5">
      <%= render Ui::SettingsRowComponent.new(label: "AI Scene Summaries", sub: "Auto-summarize when scenes resolve", position: :last) do %>
        <%= button_to toggle_ai_summaries_enabled_game_path(@game_presenter), method: :patch, class: "bg-transparent border-0 p-0 cursor-pointer",
              "aria-label": @game_presenter.ai_summaries_toggle_aria_label do %>
          <%= render Ui::ToggleSwitchComponent.new(state: @game_presenter.ai_summaries_enabled? ? :on : :off) %>
        <% end %>
      <% end %>
    </div>
  <% end %>

  <%# Export %>
  <%= render Ui::SectionLabelComponent.new(html_class: "mt-2") do %>Export<% end %>
  <%= render Ui::CardComponent.new do %>
    <%= render Ui::SettingsRowComponent.new(label: "This game", sub: @game_presenter.export_notice, position: :last) do %>
      <%= render Ui::ButtonComponent.new(style: Ui::ButtonComponent::Style.new(variant: :text), link: Ui::ButtonComponent::Link.new(url: game_export_path(@game_presenter), method: :post)) do %>Export Game<% end %>
    <% end %>
  <% end %>

  <% if @game_presenter.can_manage? %>
    <%# Danger Zone — GM-only game deletion %>
    <%= render Shared::DeleteGameComponent.new(game: @game_presenter) %>
  <% end %>
<% end %>
