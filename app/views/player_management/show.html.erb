<% content_for :active_game_id, @game_presenter.id %>

<%= render Shared::MobileFrameComponent.new do |frame| %>
  <% frame.with_header do %>
    <%= render Shared::HeaderComponent.new(
          title: "Game Settings",
          breadcrumbs: Shared::BreadcrumbsComponent.new(game_presenter: @game_presenter)) %>
  <% end %>

  <% if @game_presenter.can_manage? %>
    <%# Game Details %>
    <%= render Shared::GameDetailsComponent.new(game: @game_presenter) %>

    <%# Members %>
    <%= render Shared::MemberRosterComponent.new(game: @game_presenter, members: @roster) %>

    <%# Game Preferences %>
    <%= render Ui::SectionLabelComponent.new(html_class: "mt-2") do |label| %>
      <% label.with_action do %>
        <%= render Ui::InfoLinkComponent.new(url: ai_control_plane_path) %>
      <% end %>
      Game Preferences
    <% end %>
    <div class="bg-card border border-card-border rounded-card px-3.5">
      <%= render Shared::AiSummariesToggleComponent.new(game: @game_presenter, presentation: :row) %>
    </div>
  <% end %>

  <%# Export %>
  <%= render Ui::SectionLabelComponent.new(html_class: "mt-2") do %>Export<% end %>
  <%= render Ui::CardComponent.new do %>
    <%= render Ui::SettingsRowComponent.new(label: "This game", sub: @game_presenter.export_notice, position: :last) do %>
      <%= render Ui::ButtonComponent.new(style: Ui::ButtonComponent::Style.new(variant: :text), link: Ui::ButtonComponent::Link.new(url: game_export_path(@game_presenter), method: :post)) do %>Export Game<% end %>
    <% end %>
  <% end %>

  <% if @game_presenter.can_manage? %>
    <%# Danger Zone — GM-only game deletion %>
    <%= render Shared::DeleteGameComponent.new(game: @game_presenter) %>
  <% end %>
<% end %>
