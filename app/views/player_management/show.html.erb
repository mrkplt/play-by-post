<% content_for :active_game_id, @game.id %>

<%= render Shared::MobileFrameComponent.new do |frame| %>
  <% frame.with_header do %>
    <%= render Shared::PageHeaderComponent.new(title: "Game Settings", leading: :back, back_href: game_path(@game)) %>
  <% end %>

  <% if @game_presenter.gm? %>
    <%# Game Details %>
    <%= render Ui::SectionLabelComponent.new do %>Game Details<% end %>
    <%= render Ui::CardComponent.new do %>
      <%= render Ui::SettingsRowComponent.new(
            label: @game.name, sub: @game_presenter.description_display, last: true) do %>
        <%= link_to "Edit", edit_game_path(@game), class: "text-xs font-bold text-accent no-underline" %>
      <% end %>
    <% end %>

    <%# Members %>
    <%= render Ui::SectionLabelComponent.new(html_class: "mt-2") do %>Members<% end %>
    <% if @members.empty? %>
      <p class="text-muted-2 text-sm">No players yet.</p>
    <% else %>
      <div class="bg-card border border-card-border rounded-card px-3.5">
        <% @members.each_with_index do |member, i| %>
          <%= render Ui::SettingsRowComponent.new(
                label: @member_display_names[member.user_id],
                sub: @member_characters[member.user_id],
                last: i == @members.length - 1) do %>
            <% if member.active? %>
              <%= form_with url: game_player_management_game_member_path(@game, member), method: :patch, class: "inline" do |f| %>
                <%= f.hidden_field :status, value: "removed" %>
                <%= f.submit "Remove", class: "text-[11px] font-bold text-row-ink bg-transparent border-0 cursor-pointer p-0",
                      data: { confirm: "Remove this player? They keep read-only access." } %>
              <% end %>
              <%= form_with url: game_player_management_game_member_path(@game, member), method: :patch, class: "inline" do |f| %>
                <%= f.hidden_field :status, value: "banned" %>
                <%= f.submit "Ban", class: "text-[11px] font-bold text-danger bg-transparent border-0 cursor-pointer p-0",
                      data: { confirm: "Ban this player? This permanently revokes all access and cannot be undone easily." } %>
              <% end %>
            <% elsif member.removed? %>
              <%= form_with url: game_player_management_game_member_path(@game, member), method: :patch, class: "inline" do |f| %>
                <%= f.hidden_field :status, value: "active" %>
                <%= f.submit "Reinstate", class: "text-[11px] font-bold text-accent bg-transparent border-0 cursor-pointer p-0" %>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      </div>
    <% end %>

    <%# Game Preferences %>
    <%= render Ui::SectionLabelComponent.new(html_class: "mt-2") do %>Game Preferences<% end %>
    <div class="bg-card border border-card-border rounded-card px-3.5">
      <%= render Ui::SettingsRowComponent.new(label: "AI Scene Summaries", sub: "Auto-summarize when scenes resolve", last: true) do %>
        <%= button_to toggle_ai_summaries_enabled_game_path(@game), method: :patch, class: "bg-transparent border-0 p-0 cursor-pointer",
              "aria-label": (@game.ai_summaries_enabled? ? "Disable AI scene summaries" : "Enable AI scene summaries") do %>
          <%= render Ui::ToggleSwitchComponent.new(on: @game.ai_summaries_enabled?) %>
        <% end %>
      <% end %>
    </div>
  <% end %>

  <%# Export %>
  <%= render Ui::SectionLabelComponent.new(html_class: "mt-2") do %>Export<% end %>
  <%= render Ui::CardComponent.new do %>
    <%= render Ui::SettingsRowComponent.new(label: "This game", sub: @export_notice, last: true) do %>
      <%= button_to "Export Game", game_export_path(@game), method: :post,
            class: "text-[11px] font-bold text-accent bg-transparent border-0 cursor-pointer p-0" %>
    <% end %>
  <% end %>

  <% if @game_presenter.gm? %>
    <%# Danger Zone — GM-only game deletion %>
    <%= render Shared::DeleteGameComponent.new(game: @game) %>
  <% end %>
<% end %>
