<%# Replacing the form re-renders it around the saved record, so validation
    errors appear in place and a successful save leaves the writer exactly where
    they were — the pages/notebook idiom. The toast layer is replaced
    separately: it lives outside the form, in the layout. %>
<%= turbo_stream.replace "edit_character_#{@character_presenter.id}_form" do %>
  <%= render Shared::CharacterFormComponent.new(character: @character_presenter) %>
<% end %>

<%= turbo_stream.replace "toast_layer" do %>
  <%= render Ui::ToastComponent.new(toasts: FlashPresenter.new(flash).toasts) %>
<% end %>
