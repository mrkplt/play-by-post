<% content_for :active_game_id, @game.id %>

<%= render Shared::MobileFrameComponent.new do |frame| %>
  <% frame.with_header do %>
    <%= render Shared::PageHeaderComponent.new(title: "New Character", leading: :back, back_href: game_path(@game)) %>
  <% end %>

  <%= render Shared::CharacterFormComponent.new(
        game: @game, character: @character, users: @users,
        new_record: true, can_assign_owner: policy(@character).assign_owner?,
        archived: false, back_href: game_path(@game)) %>
<% end %>
