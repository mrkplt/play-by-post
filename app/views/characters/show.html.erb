<% content_for :active_game_id, @game.id %>

<%= render Shared::MobileFrameComponent.new do |frame| %>
  <% frame.with_header do %>
    <%= render Shared::PageHeaderComponent.new(title: @character.name, leading: :back, back_href: game_path(@game)) %>
  <% end %>

  <div class="flex items-center gap-2 flex-wrap">
    <span class="text-[11px] text-muted-2">Player: <%= @character_owner.display_name_or_email %></span>
    <% if @character.archived? %>
      <%= render(Ui::BadgeComponent.new(variant: :gray)) { "Archived" } %>
    <% end %>
    <% if @character.hidden? %>
      <%= render(Ui::BadgeComponent.new(variant: :yellow)) { "Hidden" } %>
    <% end %>
    <% if policy(@character).update? %>
      <%= link_to "Edit", edit_game_character_path(@game, @character), class: "ml-auto text-xs font-semibold text-accent no-underline" %>
    <% end %>
  </div>

  <div class="bg-card border border-card-border rounded-card p-4">
    <% if @character.content.present? %>
      <div class="markdown-base character-sheet-content"><%= render_markdown(@character.content) %></div>
    <% else %>
      <p class="text-muted-2 m-0 text-sm">No sheet content yet.</p>
    <% end %>
  </div>

  <%= render Shared::CharacterVersionHistoryComponent.new(
        game: @game, character: @character, versions: @versions.to_a, editor_names: @version_editor_names) %>
<% end %>
