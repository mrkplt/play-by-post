<% content_for :active_game_id, @game_presenter.id %>

<%= render Shared::MobileFrameComponent.new do |frame| %>
  <% frame.with_header do %>
    <%= render Shared::HeaderComponent.new(
          title: @character_presenter.name,
          breadcrumbs: Shared::BreadcrumbsComponent.new(game_presenter: @game_presenter),
          secondary_nav: Shared::GameNavComponent.new(game_presenter: @game_presenter, active_tab: :roster, mode: :link)) %>
  <% end %>

  <div class="flex items-center gap-2 flex-wrap">
    <span class="text-[11px] text-muted-2">Player: <%= @character_show_presenter.owner.display_name_or_email %></span>
    <% if @character_presenter.archived? %>
      <%= render(Ui::BadgeComponent.new(variant: :gray)) { "Archived" } %>
    <% end %>
    <% if @character_presenter.hidden? %>
      <%= render(Ui::BadgeComponent.new(variant: :yellow)) { "Hidden" } %>
    <% end %>
    <% if @character_presenter.can_edit? %>
      <%= link_to "Edit", @character_presenter.edit_href, class: "ml-auto text-xs font-semibold text-accent no-underline" %>
    <% end %>
  </div>

  <%# Wrapped in the stable id CharacterImagesController swaps in place after an
      upload / make-current / delete (matches ImageLibrary#library_target_id). %>
  <div id="image_library_character_image">
    <%= render Shared::ImageLibraryComponent.new(
          title: "Portraits",
          images: @character_show_presenter.portrait_items,
          can_manage: @character_show_presenter.can_manage_portraits?,
          empty_text: "No portraits yet.") %>
  </div>

  <% if @character_show_presenter.can_manage_portraits? %>
    <%= render Shared::ImageCropperComponent.new(
          upload_url: @character_show_presenter.portrait_upload_url,
          title: "Add a portrait",
          add_label: "Add portrait") %>
  <% end %>

  <div class="bg-card border border-card-border rounded-card p-4">
    <% if @character_presenter.content? %>
      <%= render Ui::MarkdownRenderComponent.new(text: @character_presenter.content, content_class: "character-sheet-content") %>
    <% else %>
      <p class="text-muted-2 m-0 text-sm">No sheet content yet.</p>
    <% end %>
  </div>

  <%= render Shared::CharacterVersionHistoryComponent.new(
        character: @character_presenter, versions: @character_show_presenter.versions) %>
<% end %>
