<% content_for :active_game_id, @game.id %>

<%= render Shared::MobileFrameComponent.new do |frame| %>
  <% frame.with_header do %>
    <%= render Shared::PageHeaderComponent.new(title: "Edit — #{@character.name}", leading: :back, back_href: game_character_path(@game, @character)) %>
  <% end %>

  <%= render Shared::CharacterFormComponent.new(
        game: @game, character: @character, users: [],
        new_record: false, can_assign_owner: policy(@character).assign_owner?,
        archived: @character.archived?, back_href: game_character_path(@game, @character)) %>
<% end %>
