<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || Branding.display_name %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%# Browser error tracking (GlitchTip), loaded before app JS so early errors
        are caught. Rendered only when a DSN is configured; dev/CI/test have none
        and load nothing. GlitchTip has no public ingress, so events are tunnelled
        same-origin through /errors/tunnel and forwarded server-side — the SDK's
        DSN host is never contacted from the browser. Errors-only bundle (no
        tracing/replay/sessions, which GlitchTip does not support). See Fizzy #83. %>
    <% if ErrorTracking.enabled? %>
      <meta name="glitchtip-dsn" content="<%= ErrorTracking.dsn %>">
      <script
        src="https://browser.sentry-cdn.com/10.70.0/bundle.min.js"
        integrity="sha384-79FhSq4eaPA7rdWwXh1Jly3F3Wvgq7HChMpaIIx7feYEZicWt/LnwIfTFTXSJao5"
        crossorigin="anonymous"></script>
      <script>
        Sentry.init({
          dsn: document.querySelector('meta[name="glitchtip-dsn"]').content,
          tunnel: "<%= error_tunnel_path %>"
        });
      </script>
    <% end %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <div data-controller="sidebar feedback" data-action="keydown@window->sidebar#closeOnEscape">
      <% if user_signed_in? %>
        <%= render Shared::NavShellComponent.new(current_user: UserPresenter.new(current_user), active_game_id: content_for(:active_game_id).presence&.to_i) %>
      <% end %>

      <%# Rendered as a sibling of the nav drawer, not inside the main column:
          the toast layer is fixed-position and must never occupy flow, or it
          pushes the screen's header down (the bug that made flash messages
          read as "nothing happened"). The layer spans the full viewport and
          centres toasts on the whole page, ignoring the desktop nav rail. %>
      <%= render Ui::ToastComponent.new(toasts: FlashPresenter.new(flash).toasts) %>

      <!-- Main -->
      <div>
        <%= yield %>
      </div>
    </div>
  <script>
    function applyLocalTimes() {
      document.querySelectorAll("time[data-local-time]").forEach(function(el) {
        var d = new Date(el.dataset.localTime);
        el.textContent = d.toLocaleString(undefined, {
          month: "short", day: "numeric", year: "numeric",
          hour: "numeric", minute: "2-digit"
        });
      });
    }
    document.addEventListener("DOMContentLoaded", applyLocalTimes);
    document.addEventListener("turbo:render", applyLocalTimes);
  </script>
  </body>
</html>
