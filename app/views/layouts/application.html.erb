<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Play By Post" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <div data-controller="sidebar feedback" data-action="keydown@window->sidebar#closeOnEscape">
      <% if user_signed_in? %>
        <%= render Shared::NavShellComponent.new(current_user: UserPresenter.new(current_user), active_game_id: content_for(:active_game_id).presence&.to_i) %>
      <% end %>

      <%# Rendered as a sibling of the nav drawer, not inside the main column:
          the toast layer is fixed-position and must never occupy flow, or it
          pushes the screen's header down (the bug that made flash messages
          read as "nothing happened"). Sibling placement is also what the
          desktop `.nav-drawer ~ .toast-layer` rail offset selects on. %>
      <%= render Ui::ToastComponent.new(toasts: FlashPresenter.new(flash).toasts) %>

      <!-- Main -->
      <div>
        <%= yield %>
      </div>
    </div>
  <script>
    function applyLocalTimes() {
      document.querySelectorAll("time[data-local-time]").forEach(function(el) {
        var d = new Date(el.dataset.localTime);
        el.textContent = d.toLocaleString(undefined, {
          month: "short", day: "numeric", year: "numeric",
          hour: "numeric", minute: "2-digit"
        });
      });
    }
    document.addEventListener("DOMContentLoaded", applyLocalTimes);
    document.addEventListener("turbo:render", applyLocalTimes);
  </script>
  </body>
</html>
