<%= render Shared::MobileFrameComponent.new do |frame| %>
  <% frame.with_header do %>
    <%= render Shared::HeaderComponent.new(title: "Profile") %>
  <% end %>

  <%# Display Name %>
  <%= render Ui::SectionLabelComponent.new do %>Display Name<% end %>
  <div class="bg-card border border-card-border rounded-card px-3.5">
    <%= render Ui::SettingsRowComponent.new(label: @profile.display_name.presence || "Not set", last: true) do %>
      <%= link_to "Edit", edit_profile_path, class: "text-xs font-bold text-accent no-underline" %>
    <% end %>
  </div>

  <%# Email + Preferences %>
  <%= render Ui::SectionLabelComponent.new(html_class: "mt-2") do %>Account<% end %>
  <div class="bg-card border border-card-border rounded-card px-3.5">
    <%= render Ui::SettingsRowComponent.new(label: "Email", sub: current_user.email) do %>
    <% end %>
    <%= render Ui::SettingsRowComponent.new(label: "Hide OOC by default", sub: "Collapse out-of-character posts", last: true) do %>
      <%= button_to toggle_hide_ooc_profile_path, method: :post, class: "bg-transparent border-0 p-0 cursor-pointer",
            "aria-label": (@profile.hide_ooc? ? "Show OOC posts by default" : "Hide OOC posts by default") do %>
        <%= render Ui::ToggleSwitchComponent.new(on: @profile.hide_ooc?) %>
      <% end %>
    <% end %>
  </div>

  <%# RSS Feed Tokens — one row per game the user belongs to %>
  <%= render Ui::SectionLabelComponent.new(html_class: "mt-2") do %>RSS Feed Tokens<% end %>
  <%= render Ui::CardComponent.new do %>
    <% profile_rss_scopes(current_user).each do |scope| %>
      <%= render Shared::RssTokenComponent.new(
            scope_label: scope.label,
            feed_url: rss_feed_url(scope.token),
            form_path: generate_rss_token_profile_path,
            revoke_path: revoke_rss_token_profile_path,
            scope_param: rss_scope_param(scope.game),
            last: scope.last
          ) %>
    <% end %>
  <% end %>

  <%# Export %>
  <%= render Ui::SectionLabelComponent.new(html_class: "mt-2") do %>Export<% end %>
  <div class="bg-card border border-card-border rounded-card px-3.5">
    <%= render Ui::SettingsRowComponent.new(label: "All your games", sub: export_all_games_notice(@export_all_receipt), last: true) do %>
      <%= button_to "Export All Games", export_all_profile_path, method: :post,
            class: "text-xs font-bold text-accent bg-transparent border-0 cursor-pointer p-0" %>
    <% end %>
  </div>
<% end %>
