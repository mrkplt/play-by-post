<%= render Shared::MobileFrameComponent.new do |frame| %>
  <% frame.with_header do %>
    <%= render Shared::HeaderComponent.new(title: "Profile") %>
  <% end %>

  <%# Display Name — edits in place (Ui::ProfileDisplayNameFieldComponent),
      no separate edit page trip. The component owns its own row layout (it
      is not a fixed-label/control pair like Ui::SettingsRowComponent — the
      "label" itself becomes the editable control). %>
  <%= render Ui::SectionLabelComponent.new do %>Display Name<% end %>
  <%= render Ui::CardComponent.new do %>
    <%= render Ui::ProfileDisplayNameFieldComponent.new(profile: @profile_presenter, update_url: profile_path) %>
  <% end %>

  <%# Avatar. Wrapped in the stable id UserImagesController swaps in place after
      an upload / make-current / delete (matches ImageLibrary#library_target_id). %>
  <div id="image_library_user_image">
    <%= render Shared::ImageLibraryComponent.new(
          title: "Avatar",
          images: @user_presenter.avatar.items,
          can_manage: true,
          empty_text: "No avatar yet.") %>
  </div>
  <%= render Shared::ImageCropperComponent.new(
        upload_url: @user_presenter.avatar.upload_url,
        title: "Add an avatar",
        add_label: "Add avatar") %>

  <%# Email + Preferences %>
  <%= render Ui::SectionLabelComponent.new(html_class: "mt-2") do %>Account<% end %>
  <%= render Ui::CardComponent.new do %>
    <%= render Ui::SettingsRowComponent.new(label: "Email", sub: current_user.email) do %>
    <% end %>
    <%= render Ui::SettingsRowComponent.new(label: "Hide OOC by default", sub: "Collapse out-of-character posts") do %>
      <%= render Ui::ProfileOocToggleComponent.new(
        hide_ooc: @profile_presenter.hide_ooc?,
        toggle_url: toggle_hide_ooc_profile_path
      ) %>
    <% end %>
  <% end %>

  <%# AI (AI Control Plane): the viewer's own display preference, then their
      BYOK key. Display preference is a per-user setting, so it heads this
      section rather than sitting among BYOK's key controls. %>
  <%= render Ui::SectionLabelComponent.new(html_class: "mt-2") do |label| %>
    <% label.with_action do %>
      <%= render Ui::InfoLinkComponent.new(url: ai_control_plane_path) %>
    <% end %>
    AI
  <% end %>
  <%= render Ui::CardComponent.new do %>
    <%= render Ui::SettingsRowComponent.new(label: "AI display", sub: "How AI-generated content appears to you", position: :last) do %>
      <%= render Ui::ProfileAiDisplayPreferenceControlComponent.new(
        preference: @profile_presenter.ai_display_preference,
        update_url: update_ai_display_preference_profile_path
      ) %>
    <% end %>
  <% end %>
  <%= render Ui::ByokKeyFormComponent.new(
        key_present: @user_presenter.byok_key.present?,
        public_key_pem: @user_presenter.byok_key.public_key_pem,
        endpoint_url: profile_byok_key_path,
        pending: false) %>

  <%# Your Games — the per-game control plane (feed, API token, AI funding),
      grouped game-first so each game's controls read together. %>
  <%= render "game_controls", user_presenter: @user_presenter %>

  <%# Export %>
  <%= render Ui::SectionLabelComponent.new(html_class: "mt-2") do %>Export<% end %>
  <%= render Ui::CardComponent.new do %>
    <%= render Ui::SettingsRowComponent.new(label: "All your games", sub: @user_presenter.export_all_games_notice, position: :last) do %>
      <%= button_to "Export All Games", export_all_profile_path, method: :post,
            class: "text-xs font-bold text-accent bg-transparent border-0 cursor-pointer p-0" %>
    <% end %>
  <% end %>
<% end %>
