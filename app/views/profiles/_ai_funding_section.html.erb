<%# Fund AI for your games — offer your key per game/feature (only meaningful
    once you have a key of your own to make available). Wrapped in a stable id
    so Profiles::ByokKeysController#update/#destroy can refresh it in place
    when key presence changes. %>
<div id="ai_funding_section">
  <% if user_presenter.byok_key.present? %>
    <%= render Ui::SectionLabelComponent.new(html_class: "mt-2") do %>Fund AI for your games<% end %>
    <%= render Shared::KeyContributionMatrixComponent.new(rows: user_presenter.key_contribution_rows) %>
  <% end %>
</div>
