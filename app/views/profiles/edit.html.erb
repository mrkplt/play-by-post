<%= render Shared::MobileFrameComponent.new do |frame| %>
  <% frame.with_header do %>
    <%= render Shared::HeaderComponent.new(title: "Set Display Name") %>
  <% end %>

  <% frame.with_footer do %>
    <%= render Shared::PageActionsComponent.new do |actions| %>
      <% actions.with_primary do %>
        <%= render Ui::ButtonComponent.new(html_options: { type: "submit", form: "profile_edit_form" }) do %>Save<% end %>
      <% end %>
      <% actions.with_cancel do %>
        <%= render Ui::ButtonComponent.new(variant: :secondary, url: profile_path) do %>Cancel<% end %>
      <% end %>
    <% end %>
  <% end %>

  <%= render Shared::ProfileFormComponent.new(profile: @profile_presenter) %>
<% end %>
