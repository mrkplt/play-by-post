<nav class="text-sm mb-4 text-slate-500">
  <%= link_to "Games", root_path %> &rsaquo;
  <%= link_to @game.name, game_path(@game) %> &rsaquo;
  Game Files
</nav>

<div class="flex items-center justify-between mb-4">
  <h1 class="m-0 text-xl font-semibold">Game Files</h1>
</div>

<% if @is_gm %>
  <%= render Shared::FileUploadFormComponent.new(game: @game, game_file: @game_file) %>
<% end %>

<% if @game_files.empty? %>
  <p class="text-slate-400">No files uploaded yet.</p>
<% else %>
  <%= render Shared::GalleryComponent.new(game_files: @game_files.to_a, game: @game, is_gm: @is_gm) %>
<% end %>
