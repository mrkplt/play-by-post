<% content_for :active_game_id, @game.id %>

<%= render Shared::MobileFrameComponent.new do |frame| %>
  <% frame.with_header do %>
    <%= render Shared::HeaderComponent.new(
          title: "Edit Participants — #{@scene.title}",
          breadcrumbs: Shared::BreadcrumbsComponent.new(game: @game),
          secondary_nav: Shared::GameNavComponent.new(game: @game, active_tab: :scenes, can_manage: policy(@game).update?, mode: :link)) %>
  <% end %>

  <% frame.with_footer do %>
    <%= render Shared::PageActionsComponent.new do |actions| %>
      <% actions.with_primary do %>
        <%= render Ui::ButtonComponent.new(html_options: { type: "submit", form: "scene_participants_edit_form" }) do %>Update Participants<% end %>
      <% end %>
      <% actions.with_cancel do %>
        <%= render Ui::ButtonComponent.new(variant: :secondary, url: game_scene_path(@game, @scene)) do %>Cancel<% end %>
      <% end %>
    <% end %>
  <% end %>

  <%= form_with url: game_scene_participants_path(@game, @scene), method: :patch, html: { id: "scene_participants_edit_form" } do %>
    <%= render Shared::ParticipantCheckboxListComponent.new(
          players_with_characters: @players_with_characters,
          selected_character_ids: @current_character_ids.map(&:to_s),
          variant: :simple) %>
  <% end %>
<% end %>
