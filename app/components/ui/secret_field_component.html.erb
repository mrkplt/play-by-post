<div class="flex items-center gap-2" data-controller="secret-field">
  <input type="password" readonly
         value="<%= value %>"
         aria-label="<%= label %>"
         data-secret-field-target="input"
         class="<%= Ui::SecretFieldComponent::INPUT_CLASSES %>">
  <button type="button"
          data-action="secret-field#toggle"
          data-secret-field-target="toggle"
          class="<%= Ui::SecretFieldComponent::BUTTON_CLASSES %>">Show</button>
  <button type="button"
          data-action="secret-field#copy"
          data-secret-field-target="copy"
          class="<%= Ui::SecretFieldComponent::BUTTON_CLASSES %>">Copy</button>
</div>
