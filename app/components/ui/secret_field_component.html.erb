<div class="secret-field" data-controller="secret-field" data-secret-field-value-value="<%= value %>">
  <%# The row already names what this secret is (the game/section label), so the
      visible label here would just repeat it once per row. Kept for screen
      readers (and it mirrors the input's aria-label) but hidden visually. %>
  <label class="sr-only"><%= label %></label>
  <div class="secret-field__row">
    <input type="text" readonly
           class="secret-field__input"
           value="<%= masked_value %>"
           data-secret-field-target="display"
           aria-label="<%= label %>">
    <%# Show / Copy / Revoke are the field's inline contextual commands: the
        one button primitive in its text variant (destructive for Revoke),
        sized to match. Show and Copy are Stimulus-wired bare buttons; Revoke
        is a delete action carried as a turbo-method link. %>
    <%= render Ui::ButtonComponent.new(
          style: Ui::ButtonComponent::Style.new(variant: :text, size: :sm),
          html_options: { data: { action: "secret-field#toggle", "secret-field-target": "toggle" }, "aria-label": "Show value" }) do %>Show<% end %>
    <%= render Ui::ButtonComponent.new(
          style: Ui::ButtonComponent::Style.new(variant: :text, size: :sm),
          html_options: { data: { action: "secret-field#copy" }, "aria-label": "Copy value" }) do %>Copy<% end %>
    <% if revoke_path %>
      <%= render Ui::ButtonComponent.new(
            style: Ui::ButtonComponent::Style.new(variant: :text_danger, size: :sm),
            link: Ui::ButtonComponent::Link.new(url: revoke_path, method: :delete)) do %>Revoke<% end %>
    <% end %>
  </div>
</div>
