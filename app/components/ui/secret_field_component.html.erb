<div class="secret-field" data-controller="secret-field" data-secret-field-value-value="<%= value %>">
  <label class="secret-field__label"><%= label %></label>
  <div class="secret-field__row">
    <input type="text" readonly
           class="secret-field__input"
           value="<%= masked_value %>"
           data-secret-field-target="display"
           aria-label="<%= label %>">
    <button type="button"
            class="secret-field__btn"
            data-action="secret-field#toggle"
            data-secret-field-target="toggle"
            aria-label="Show value">Show</button>
    <button type="button"
            class="secret-field__btn"
            data-action="secret-field#copy"
            aria-label="Copy value">Copy</button>
  </div>
</div>
