<div class="<%= row_classes %>">
  <div class="flex flex-col min-w-0">
    <span class="text-[13px] text-ink font-semibold"><%= label %></span>
    <% if sub %>
      <span class="text-[11px] text-muted-2"><%= sub %></span>
    <% end %>
  </div>
  <div class="<%= control_classes %>"><%= content %></div>
</div>
