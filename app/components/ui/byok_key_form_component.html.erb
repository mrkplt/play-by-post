<%# The whole control lives in one Turbo Frame (FRAME_ID): #create/#update/
    #destroy replace it via Turbo Stream, and the pending branch's frame-poll
    controller reloads it (GET #show on endpoint_url) until the keypair exists
    and the paste form renders — polling, not a broadcast, so the reveal is
    deterministic. %>
<%= helpers.turbo_frame_tag frame_id do %>
  <div class="<%= card_classes %>">
    <div class="flex items-center justify-between gap-2">
      <p class="<%= heading_classes %>"><%= heading %></p>
      <%= render Ui::InfoLinkComponent.new(url: helpers.ai_control_plane_path) %>
    </div>

    <% if pending? %>
      <%= render Shared::PendingIndicatorComponent.new(
            message: pending_message,
            data: { controller: "frame-poll", "frame-poll-url-value": endpoint_url }) %>
    <% else %>
      <p class="text-xs text-muted mb-3"><%= status_text %></p>

      <% if key_present? %>
        <%= render Ui::ButtonComponent.new(
              style: Ui::ButtonComponent::Style.new(variant: :text_danger, size: :sm),
              link: Ui::ButtonComponent::Link.new(url: endpoint_url, method: :delete)) do %>Delete key<% end %>
      <% elsif keypair_ready? %>
        <%= form_with url: endpoint_url, method: :patch, scope: :byok_key,
              data: {
                controller: "byok-key-seal",
                "byok-key-seal-public-key-value": public_key_pem,
                action: "submit->byok-key-seal#submitForm"
              } do |form| %>
          <label class="text-xs text-muted block mb-1" for="byok_key_plaintext">OpenRouter API key</label>
          <input type="password" id="byok_key_plaintext" autocomplete="off"
                 class="w-full rounded-control border border-card-border bg-transparent px-2.5 py-2 text-sm text-ink mb-2"
                 data-byok-key-seal-target="plaintext"
                 placeholder="sk-or-v1-...">

          <%= form.hidden_field :wrapped_key, data: { "byok-key-seal-target": "wrappedKey" } %>
          <%= form.hidden_field :iv, data: { "byok-key-seal-target": "iv" } %>
          <%= form.hidden_field :ciphertext, data: { "byok-key-seal-target": "ciphertext" } %>

          <p class="text-xs text-danger mb-2 hidden" data-byok-key-seal-target="error"></p>

          <%= render Ui::ButtonComponent.new(
                style: Ui::ButtonComponent::Style.new(variant: :primary, size: :sm),
                html_options: { type: "submit", data: { "byok-key-seal-target": "submit" } }) do %>Save key<% end %>
        <% end %>
      <% else %>
        <%= render Ui::ButtonComponent.new(
              style: Ui::ButtonComponent::Style.new(variant: :text, size: :sm),
              link: Ui::ButtonComponent::Link.new(url: endpoint_url, method: :post)) do %>Set up encryption<% end %>
      <% end %>
    <% end %>
  </div>
<% end %>
