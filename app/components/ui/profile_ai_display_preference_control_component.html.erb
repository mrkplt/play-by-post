<div class="<%= wrapper_classes %>" role="group" aria-label="AI display preference">
  <% options.each do |option| %>
    <%= button_to option.label, update_url, method: :post,
          params: { ai_display_preference: option.value },
          class: option_classes(option),
          form_class: "inline-block",
          aria: { pressed: aria_pressed(option) } %>
  <% end %>
</div>
