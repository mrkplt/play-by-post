<div class="<%= row_classes %>">
  <%= render Ui::IdentityBlockComponent.new(
        name: name,
        primary: name,
        secondary: subtitle,
        config: Ui::IdentityBlockComponent::Config.new(
          orientation: :inline, size: :md, variant: variant,
          avatar_tone: avatar_tone, avatar_size: :sm, crown: crown?)) %>
  <div class="flex-shrink-0"><%= content %></div>
</div>
