<% if show_ai_notice? %>
  <div class="mb-4 p-3 bg-tint-blue-bg border border-tint-blue-border rounded-card text-sm text-body-ink">
    This summary was generated by AI. Editing it will mark it as hand-edited and clear the AI metadata.
  </div>
<% end %>

<%= form_with model: @summary, url: @summary.routes.submit_path, html: { id: form_id }, class: "flex flex-col gap-4",
      data: autosave? ? { controller: "draft", draft_save_url_value: save_draft_path, draft_publish_label_value: submit_label, draft_param_key_value: "scene_summary" } : {} do |f| %>
  <%= render Ui::FormErrorsComponent.new(messages: error_messages) %>

  <div class="flex flex-col gap-1.5">
    <%= f.label :body, "Summary", class: "text-[11px] font-bold text-muted uppercase tracking-[0.05em]" %>
    <%= render Ui::MarkdownEditorComponent.new(
          binding: { form: f, field: :body },
          config: Ui::MarkdownEditorComponent::Config.with_preview,
          field: Ui::MarkdownEditorComponent::Field.new(rows: 10, placeholder: "Write a narrative summary of this scene...",
            data: autosave? ? { draft_target: "content", action: "input->draft#scheduleSave" } : {})) %>
  </div>

  <% if autosave? %>
    <label class="flex items-center gap-2 text-[13px] font-semibold text-row-ink cursor-pointer">
      <input type="checkbox" class="w-[18px] h-[18px] accent-accent" data-draft-target="saveAsDraftToggle" data-action="change->draft#toggleSaveAsDraft" <%= "checked" if draft? %>>
      Save as draft (only you can see it until you publish)
    </label>
  <% end %>
<% end %>
