<div id="new_notebook_entry_form">
  <%= form_with model: [ game, notebook_entry ], html: { id: form_id }, class: "flex flex-col gap-4" do |f| %>
    <% if errors? %>
      <div class="bg-tint-blue-bg border border-tint-blue-border rounded-card p-3 text-sm text-danger">
        <% error_messages.each do |msg| %>
          <div><%= msg %></div>
        <% end %>
      </div>
    <% end %>

    <div class="flex flex-col gap-1.5">
      <%= f.label :title, class: "text-[11px] font-bold text-muted uppercase tracking-[0.05em]" %>
      <%= f.text_field :title, autofocus: true, placeholder: "Entry title",
            class: "w-full border border-input-border rounded-control px-3 py-2.5 text-sm text-ink bg-card placeholder:text-muted-2" %>
    </div>

    <div class="flex flex-col gap-1.5">
      <%= f.label :body, "Body (markdown supported)", class: "text-[11px] font-bold text-muted uppercase tracking-[0.05em]" %>
      <%# Notebook entries are GM scratchpad, not published content, so the
          editor is a large writing surface with no live preview — presentation
          waits until the entry is promoted to a Page. Dropping the preview is
          omitting its region; there is no preview flag. %>
      <%= render Ui::MarkdownEditorComponent.new(
            binding: { form: f, field: :body },
            config: Ui::MarkdownEditorComponent::Config.new(
              edit_height: :xl,
              regions: [ Ui::MarkdownEditorComponent::ToolbarRegion.new ]),
            rows: 24,
            placeholder: "Write the entry in markdown…") %>
    </div>

  <% end %>
</div>
