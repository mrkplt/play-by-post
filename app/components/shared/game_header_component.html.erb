<header class="bg-sidebar-bg px-3 pt-2 pb-3 flex flex-col gap-2.5">
  <div class="flex items-center gap-0.5">
    <%= render Ui::IconButtonComponent.new(
          label: "Open navigation",
          html_options: { data: { action: "click->sidebar#open" } }) do %>
      <span class="text-2xl leading-none">&#9776;</span>
    <% end %>

    <% if show_crown? %>
      <%= helpers.icon "crown-03", class: "w-4 h-4 text-accent mr-0.5 flex-shrink-0" %>
    <% end %>

    <h1 class="text-white font-bold text-base m-0 truncate"><%= title %></h1>

    <% if show_gear? %>
      <div class="flex-1"></div>
      <%= render Ui::IconButtonComponent.new(href: gear_path, align: :center, label: "Player management") do %>
        <%= helpers.icon "settings-01", class: "w-5 h-5" %>
      <% end %>
    <% end %>
  </div>

  <%= render Ui::PillTabsComponent.new(tabs: tabs, active: active_tab, mode: :switch) %>
</header>
