<% if draft? %>
  <div class="bg-tint-blue-bg border border-tint-blue-border rounded-card p-4">
    <p class="text-sm font-semibold text-tint-blue-strong mb-2"><%= notice %></p>
    <%= render Ui::MarkdownRenderComponent.new(text: draft_content, variant: :draft) %>
    <%= render Ui::ButtonComponent.new(style: Ui::ButtonComponent::Style.new(variant: :text_danger), link: Ui::ButtonComponent::Link.new(url: discard_path, method: :delete)) do %>Discard Draft<% end %>
  </div>
<% end %>
