<p class="text-sm text-muted-2 mb-4">Choose a name that other players will see.</p>

<%= form_with model: profile, url: update_path, method: :patch, html: { id: form_id }, class: "flex flex-col gap-1.5" do |f| %>
  <%= f.label :display_name, "Display name", class: "text-[11px] font-bold text-muted uppercase tracking-[0.05em]" %>
  <%= f.text_field :display_name, autofocus: true, maxlength: 100,
        class: "w-full border border-input-border rounded-control px-3 py-2.5 text-sm text-ink bg-card placeholder:text-muted-2" %>
  <% if errors? %>
    <span class="text-sm text-danger"><%= error_message %></span>
  <% end %>
<% end %>
