<div class="nav-drawer-backdrop"
     hidden
     data-sidebar-target="backdrop"
     data-action="click->sidebar#close"></div>

<%# The feedback modal lives here — a sibling of the drawer, not inside it, so
    its fixed-position overlay is measured against the viewport rather than the
    off-screen (translateX) drawer. The desktop rail-offset rule is scoped to
    `.nav-drawer ~ div:last-child` (the content column), so only that column is
    pushed right — this modal and the toast layer stay full-viewport. %>
<%= render Shared::FeedbackModalComponent.new %>

<aside class="nav-drawer" data-sidebar-target="sidebar">
  <%= render Shared::NavDrawerComponent.new(current_user: current_user, active_game_id: active_game_id) %>
</aside>
