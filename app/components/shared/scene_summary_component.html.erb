<div class="bg-summary-amber-bg border border-summary-amber-border rounded-lg p-5 mt-6">
  <div class="flex justify-between items-start mb-3">
    <h3 class="m-0 text-base font-semibold text-summary-amber-heading">Scene Summary</h3>
    <div class="flex gap-2 items-center">
      <% if show_status_badge? %>
        <%= render(Ui::BadgeComponent.new(variant: status_badge_variant.to_sym)) { @summary.status_label } %>
      <% end %>
      <% if can_manage? %>
        <% if draft? %>
          <%= render(Ui::BadgeComponent.new(variant: :slate)) { "Draft" } %>
          <%= button_to "Publish", publish_path, method: :patch,
              class: "text-xs text-summary-amber-meta hover:text-summary-amber-heading bg-transparent border-none cursor-pointer p-0" %>
        <% end %>
        <%= link_to "Edit", @summary.routes.edit_path,
            class: "text-xs text-summary-amber-meta hover:text-summary-amber-heading no-underline" %>
        <%= button_to "Delete", @summary.routes.submit_path,
            method: :delete,
            class: "text-xs text-summary-delete hover:text-summary-delete-hover bg-transparent border-none cursor-pointer p-0",
            data: { confirm: "Delete this summary?" } %>
      <% end %>
    </div>
  </div>
  <%= render Ui::MarkdownRenderComponent.new(text: @summary.body, variant: :summary_amber) %>
  <% if @summary.formatted_edited_at %>
    <p class="text-xs text-summary-amber-meta mt-2 mb-0">Last edited <%= @summary.formatted_edited_at %></p>
  <% elsif @summary.formatted_generated_at %>
    <p class="text-xs text-summary-amber-meta mt-2 mb-0">Generated <%= @summary.formatted_generated_at %></p>
  <% end %>
</div>
