<%= render Ui::SettingsRowComponent.new(label: scope_label, last: !token_present? && !divide?) do %>
  <div class="flex items-center gap-3">
    <%= button_to action_label, form_path, method: :post, params: scope_param,
          class: Shared::RssTokenComponent::ACTION_CLASSES,
          data: rotate_data %>
    <% if token_present? %>
      <%= button_to "Revoke", revoke_path, method: :delete, params: scope_param,
            class: Shared::RssTokenComponent::DANGER_CLASSES,
            data: { confirm: "Revoking this token will stop its feed subscriptions. Continue?" } %>
    <% end %>
  </div>
<% end %>
<% if token_present? %>
  <%= render Ui::SettingsRowComponent.new(label: "Feed URL", last: !divide?) do %>
    <%= render Ui::SecretFieldComponent.new(value: feed_url, label: "#{scope_label} feed URL") %>
  <% end %>
<% end %>
