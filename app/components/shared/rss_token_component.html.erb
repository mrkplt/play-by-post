<div class="bg-card border border-card-border rounded-card px-3.5">
  <% if token_present? %>
    <%= render Ui::SettingsRowComponent.new(label: "Campaign log feed", sub: "Revoke to invalidate existing links", last: false) do %>
      <%= button_to "Rotate", generate_path, method: :post,
            class: "text-[11px] font-bold text-accent bg-transparent border-0 cursor-pointer p-0",
            data: { confirm: "Rotating your token will invalidate all existing feed URLs. Continue?" } %>
      <%= button_to "Revoke", revoke_path, method: :delete,
            class: "text-[11px] font-bold text-danger bg-transparent border-0 cursor-pointer p-0",
            data: { confirm: "Revoking your token will stop all feed subscriptions. Continue?" } %>
    <% end %>
    <%= render Ui::SettingsRowComponent.new(label: "Your token", last: true) do %>
      <code class="text-[11px] bg-canvas px-2 py-1 rounded break-all text-row-ink"><%= token_value %></code>
    <% end %>
  <% else %>
    <%= render Ui::SettingsRowComponent.new(label: "Campaign log feed", sub: "Read-only access to your game feeds", last: true) do %>
      <%= button_to "Generate", generate_path, method: :post,
            class: "text-[11px] font-bold text-accent bg-transparent border-0 cursor-pointer p-0" %>
    <% end %>
  <% end %>
</div>
