<div data-controller="lightbox" data-action="keydown@document->lightbox#closeOnEscape">
  <div class="grid grid-cols-[repeat(auto-fill,minmax(100px,120px))] gap-2" data-testid="gallery-grid">
    <% game_files.each do |gf| %>
      <div class="bg-white border border-line-200 rounded-lg overflow-hidden cursor-pointer relative hover:shadow-md transition-shadow"
           data-testid="gallery-card"
           data-action="click->lightbox#open"
           data-lightbox-html="<%= escape_once(gf.lightbox_html) %>"
           data-lightbox-filename="<%= gf.filename %>"
           data-lightbox-download="<%= gf.download_url %>"
           <% if gf.delete_url %>data-lightbox-delete="<%= gf.delete_url %>"<% end %>>
        <div class="w-full aspect-square flex items-center justify-center bg-surface-50 overflow-hidden">
          <% if (th = gf.thumb_html) %>
            <%= th %>
          <% else %>
            <div class="text-2xl font-bold text-meta-500 uppercase tracking-wide bg-surface-100 w-full h-full flex items-center justify-center" data-testid="gallery-card-placeholder"><%= gf.file_extension %></div>
          <% end %>
        </div>
        <div class="p-2 flex items-center gap-1">
          <span class="flex-1 min-w-0 text-xs text-ink whitespace-nowrap overflow-hidden text-ellipsis" title="<%= gf.filename %>" data-testid="gallery-card-filename"><%= gf.filename %></span>
        </div>
      </div>
    <% end %>
  </div>

  <div data-lightbox-target="modal" class="fixed inset-0 z-[1000] flex items-center justify-center p-4" hidden data-testid="lightbox" data-action="click->lightbox#closeOnBackdrop">
    <div class="absolute inset-0 bg-black/60" data-lightbox-backdrop></div>
    <div class="relative bg-white rounded-lg max-w-[90vw] max-h-[90vh] flex flex-col overflow-hidden">
      <div class="flex items-center justify-between px-4 py-3 border-b border-line-200 gap-4">
        <span class="font-semibold text-sm min-w-0 whitespace-nowrap overflow-hidden text-ellipsis" data-lightbox-title></span>
        <div class="flex items-center gap-2 shrink-0">
          <a href="#" data-lightbox-download class="text-[0.8rem] py-[0.3rem] px-3 bg-accent text-accent-ink rounded-control font-bold cursor-pointer inline-block no-underline transition-colors" data-turbo="false">Download</a>
          <% if can_manage? %>
            <button data-lightbox-delete-btn class="text-[0.8rem] py-[0.3rem] px-3 bg-white text-error-text border border-error-border rounded cursor-pointer hover:bg-error-bg" data-action="click->lightbox#confirmDelete" hidden>Delete</button>
          <% end %>
          <button class="bg-transparent border-none text-xl cursor-pointer text-meta-500 p-1 leading-none hover:text-ink" data-action="click->lightbox#close" aria-label="Close">&times;</button>
        </div>
      </div>
      <div class="flex items-center justify-center p-4 overflow-auto flex-1" data-lightbox-image></div>
    </div>
  </div>
</div>
