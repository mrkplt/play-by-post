<div class="bg-white border border-line-200 rounded-lg p-5 mb-4">
  <h3 class="mt-0">Upload File</h3>
  <% if error? %>
    <p class="px-4 py-3 rounded mb-4 text-sm bg-error-bg text-error-text-strong"><%= error_message %></p>
  <% end %>
  <%= form_with url: upload_url, multipart: true,
                data: { controller: "file-size", file_size_max_bytes_value: max_bytes } do |f| %>
    <div class="mb-4">
      <label class="block mb-1 text-sm font-medium text-meta-700">File</label>
      <input type="file" name="game_file[file]" accept=".pdf,.doc,.docx,.txt,.md,.jpg,.jpeg,.png,.gif,.webp"
             data-file-size-target="input" data-action="change->file-size#check"
             class="block max-w-md text-sm text-meta-700 border border-line-300 rounded px-3 py-2 cursor-pointer bg-white file:mr-3 file:py-1 file:px-3 file:rounded file:border-0 file:text-sm file:font-medium file:bg-surface-100 file:text-meta-700 hover:file:bg-surface-200">
      <p class="text-xs text-meta-400 mt-1 mb-0">PDF, Word, text, markdown, or image. Max <%= max_megabytes %>MB.</p>
      <p data-file-size-target="warning" class="hidden text-sm text-error-text-strong mt-2 mb-0" role="alert"></p>
    </div>
    <%= f.submit "Upload", data: { file_size_target: "submit" }, class: "px-5 py-2 bg-accent text-accent-ink rounded-control text-base font-bold cursor-pointer inline-block no-underline transition-colors disabled:opacity-50 disabled:cursor-not-allowed" %>
  <% end %>
</div>
