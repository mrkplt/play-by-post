<div class="flex items-center gap-3 flex-wrap">
  <%= render lane_select %>

  <div class="flex items-center gap-3 ml-auto">
    <% if promoted? %>
      <%= link_to promoted_label, game_page_path(game, promoted_page),
            class: "text-xs font-semibold text-accent no-underline" %>
    <% else %>
      <%= button_to "Promote", promote_game_notebook_entry_path(game, notebook_entry), method: :post,
            class: "text-xs font-semibold text-accent bg-transparent border-0 cursor-pointer p-0" %>
    <% end %>

    <%= button_to "Delete", game_notebook_entry_path(game, notebook_entry), method: :delete,
          form: { data: { turbo_confirm: confirm } },
          class: "text-xs font-semibold text-danger bg-transparent border-0 cursor-pointer p-0" %>
  </div>
</div>
