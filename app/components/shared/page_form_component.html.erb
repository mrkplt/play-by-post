<%= form_with model: [ game, page ], html: { id: form_id }, class: "flex flex-col gap-4" do |f| %>
  <%= render Ui::FormErrorsComponent.new(messages: error_messages) %>

  <div class="flex flex-col gap-1.5">
    <%= f.label :title, class: "text-[11px] font-bold text-muted uppercase tracking-[0.05em]" %>
    <%= f.text_field :title, autofocus: true, placeholder: "Page title",
          class: "w-full border border-input-border rounded-control px-3 py-2.5 text-sm text-ink bg-card placeholder:text-muted-2" %>
  </div>

  <div class="flex flex-col gap-1.5">
    <%= f.label :body, "Body (markdown supported)", class: "text-[11px] font-bold text-muted uppercase tracking-[0.05em]" %>
    <%= render Ui::MarkdownEditorComponent.new(
          binding: { form: f, field: :body },
          config: Ui::MarkdownEditorComponent::Config.with_preview,
          field: Ui::MarkdownEditorComponent::Field.new(rows: 14, placeholder: "Write the page in markdown…")) %>
  </div>

<% end %>
