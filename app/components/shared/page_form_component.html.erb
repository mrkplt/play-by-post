<%= form_with model: [ game, page ], html: { id: form_id }, class: "flex flex-col gap-4",
      data: autosave? ? { controller: "draft", draft_save_url_value: save_draft_path, draft_publish_label_value: submit_label, draft_param_key_value: "page" } : {} do |f| %>
  <%= render Ui::FormErrorsComponent.new(messages: error_messages) %>

  <div class="flex flex-col gap-1.5">
    <%= f.label :title, class: "text-[11px] font-bold text-muted uppercase tracking-[0.05em]" %>
    <%= f.text_field :title, autofocus: true, placeholder: "Page title",
          class: "w-full border border-input-border rounded-control px-3 py-2.5 text-sm text-ink bg-card placeholder:text-muted-2" %>
  </div>

  <div class="flex flex-col gap-1.5">
    <%= f.label :body, "Body (markdown supported)", class: "text-[11px] font-bold text-muted uppercase tracking-[0.05em]" %>
    <%= render Ui::MarkdownEditorComponent.new(
          binding: { form: f, field: :body },
          config: Ui::MarkdownEditorComponent::Config.with_preview,
          field: Ui::MarkdownEditorComponent::Field.new(rows: 14, placeholder: "Write the page in markdown…",
            data: autosave? ? { draft_target: "content", action: "input->draft#scheduleSave" } : {})) %>
  </div>

  <label class="flex items-center gap-2 text-[13px] font-semibold text-row-ink cursor-pointer">
    <% if autosave? %>
      <input type="checkbox" class="w-[18px] h-[18px] accent-accent" data-draft-target="saveAsDraftToggle" data-action="change->draft#toggleSaveAsDraft" <%= "checked" if draft? %>>
    <% else %>
      <%= f.check_box :draft, class: "w-[18px] h-[18px] accent-accent" %>
    <% end %>
    Save as draft (only you can see it until you publish)
  </label>

<% end %>
