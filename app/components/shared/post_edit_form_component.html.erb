<%= form_with model: [ game, scene, post ], class: "flex flex-col gap-4" do |f| %>
  <div class="flex flex-col gap-1.5">
    <%= render Ui::SectionLabelComponent.new do %>Edit Post<% end %>
    <%= render Ui::MarkdownEditorComponent.new(
          form: f, field: :content,
          config: Ui::MarkdownEditorComponent::Config.new(scroll: :preview, preview_height: 256, rows: 6),
          edit_class: "border border-input-border border-t-0 rounded-b-control px-3 py-2.5 text-base text-ink bg-card",
          preview_class: "post-content border border-card-border rounded-card px-3 py-3 mt-4") %>
  </div>

  <div class="flex gap-2 pt-1">
    <%= f.submit "Save", class: "flex-1 bg-accent text-accent-ink rounded-control py-2.5 font-bold text-[13px] border-0 cursor-pointer" %>
    <%= link_to "Cancel", game_scene_path(game, scene), class: "flex-1 text-center border border-card-border text-ink rounded-control py-2.5 font-bold text-[13px] no-underline" %>
  </div>
<% end %>
