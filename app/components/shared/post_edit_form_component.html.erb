<%= form_with model: [ game, scene, post ], html: { id: form_id }, class: "flex flex-col gap-4" do |f| %>
  <div class="flex flex-col gap-1.5">
    <%= render Ui::SectionLabelComponent.new do %>Edit Post<% end %>
    <%= render Ui::MarkdownEditorComponent.new(
          form: f, field: :content,
          config: Ui::MarkdownEditorComponent::Config.new(scroll: :preview, preview_height: :md, rows: 6),
          edit_class: "border border-input-border border-t-0 rounded-b-control px-3 py-2.5 text-base text-ink bg-card",
          preview_class: "post-content border border-card-border rounded-card px-3 py-3 mt-4") %>
  </div>
<% end %>
