<%= form_with model: [ game, scene, post ], class: "flex flex-col gap-4",
    data: { controller: "markdown-preview markdown-toolbar" } do |f| %>
  <div class="flex flex-col gap-1.5">
    <%= render Ui::SectionLabelComponent.new do %>Edit Post<% end %>
    <%= render Shared::MarkdownToolbarComponent.new %>
    <%= f.text_area :content, rows: 6,
        class: "markdown-editor w-full border border-input-border border-t-0 rounded-b-control px-3 py-2.5 text-base font-mono text-ink bg-card",
        data: {
          markdown_preview_target: "input",
          markdown_toolbar_target: "input",
          action: "input->markdown-preview#update"
        } %>
  </div>

  <div data-markdown-preview-target="preview"
       class="markdown-base post-content border border-card-border rounded-card px-3 py-3 min-h-12 bg-canvas empty:hidden"></div>

  <div class="flex gap-2 pt-1">
    <%= f.submit "Save", class: "flex-1 bg-accent text-accent-ink rounded-control py-2.5 font-bold text-[13px] border-0 cursor-pointer" %>
    <%= link_to "Cancel", game_scene_path(game, scene), class: "flex-1 text-center border border-card-border text-ink rounded-control py-2.5 font-bold text-[13px] no-underline" %>
  </div>
<% end %>
