<div id="<%= dom_id(@post) %>"
     class="<%= card_classes %>"
     data-controller="post-edit-affordance"
     data-post-edit-affordance-author-id-value="<%= edit_affordance.author_id %>"
     <% if edit_affordance.editable_until %>data-post-edit-affordance-editable-until-value="<%= edit_affordance.editable_until.iso8601 %>"<% end %>
     data-post-edit-affordance-edit-url-value="<%= @post.routes.edit_url %>"
     data-ooc="<%= ooc? %>"
     data-unread="<%= unread? %>"
     <% if unread? %>data-mark-read-url="<%= @post.routes.mark_read_url %>"<% end %>
     <% if ooc? %>data-testid="ooc-post"<% end %>>

  <%# Floated author block — body text wraps around it, illuminated-manuscript style %>
  <div class="float-left mr-3 w-16">
    <%= render Ui::IdentityBlockComponent.new(
          name: @post.author_display_name,
          primary: @post.author_display_name,
          secondary: byline_time,
          avatar_url: avatar_url,
          config: Ui::IdentityBlockComponent::Config.new(
            orientation: :stacked, size: :sm, avatar_tone: avatar_tone)) %>
  </div>

  <% if ooc? %>
    <div class="text-[10px] font-extrabold text-tint-blue-strong tracking-[0.05em] mb-1">OUT OF CHARACTER</div>
  <% end %>

  <%= render Ui::MarkdownRenderComponent.new(text: @post.content,
        variant: body_variant,
        content_attributes: { data: { testid: "post-content" } }) %>

  <div class="clear-both"></div>

  <div class="text-[11px] text-muted-2 mt-2 flex items-center gap-2">
    <% if @post.last_edited_at.present? %>
      <span class="italic">(edited)</span>
    <% end %>
    <%# Edit affordance slot. Server-rendered on a full page load when the viewer
        may edit (works with JS off); for a live-streamed post (viewer-neutral)
        the post-edit-affordance controller fills this slot client-side on the
        author's own posts within the edit window. %>
    <span data-post-edit-affordance-target="slot">
      <% if show_edit? %>
        <%= link_to "Edit", @post.routes.edit_url, class: "text-accent font-semibold" %>
      <% end %>
    </span>
  </div>
</div>
