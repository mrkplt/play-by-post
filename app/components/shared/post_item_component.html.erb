<div id="<%= dom_id(@post) %>"
     class="<%= card_classes %>"
     data-ooc="<%= ooc? %>"
     data-unread="<%= unread? %>"
     <% if unread? %>data-mark-read-url="<%= @post.mark_read_url %>"<% end %>
     <% if ooc? %>data-testid="ooc-post"<% end %>>

  <%# Floated author block — body text wraps around it, illuminated-manuscript style %>
  <div class="float-left mr-3 flex flex-col items-center gap-[3px] w-16">
    <%= render Ui::AvatarComponent.new(name: @post.author_display_name, tone: avatar_tone, size: :lg) %>
    <span class="font-bold text-[11px] text-ink text-center leading-tight"><%= @post.author_display_name %></span>
    <time class="text-[9px] text-muted-2" data-local-time="<%= @post.created_at.iso8601 %>"><%= @post.formatted_created_at %></time>
  </div>

  <% if ooc? %>
    <div class="text-[10px] font-extrabold text-tint-blue-strong tracking-[0.05em] mb-1">OUT OF CHARACTER</div>
  <% end %>

  <%= render Ui::MarkdownRenderComponent.new(text: @post.content,
        content_class: "post-content text-body-ink leading-[1.65] #{ooc? ? 'text-sm' : 'text-base'}",
        content_attributes: { data: { testid: "post-content" } }) %>

  <% if @post.image_attached? %>
    <div class="mt-2 clear-left">
      <%= image_tag @post.display_image, class: "max-w-full rounded" %>
    </div>
  <% end %>

  <div class="clear-both"></div>

  <div class="text-[11px] text-muted-2 mt-2 flex items-center gap-2">
    <% if @post.last_edited_at.present? %>
      <span class="italic">(edited)</span>
    <% end %>
    <% if @post.editable_by_viewer? %>
      <%= link_to "Edit", @post.edit_url, class: "text-accent font-semibold" %>
    <% end %>
  </div>
</div>
