<%= form_with model: game, class: "flex flex-col gap-4" do |f| %>
  <% if errors? %>
    <div class="bg-tint-blue-bg border border-tint-blue-border rounded-card p-3 text-sm text-danger">
      <% error_messages.each do |msg| %>
        <div><%= msg %></div>
      <% end %>
    </div>
  <% end %>

  <div class="flex flex-col gap-1.5">
    <%= f.label :name, class: "text-[11px] font-bold text-muted uppercase tracking-[0.05em]" %>
    <%= f.text_field :name, maxlength: 200, autofocus: true, placeholder: "Name this game",
          class: "w-full border border-input-border rounded-control px-3 py-2.5 text-base text-ink bg-card placeholder:text-muted-2" %>
  </div>

  <div class="flex flex-col gap-1.5">
    <%= f.label :description, "Description (optional, markdown supported)", class: "text-[11px] font-bold text-muted uppercase tracking-[0.05em]" %>
    <%= render Ui::MarkdownEditorComponent.new(
          form: f, field: :description,
          config: Ui::MarkdownEditorComponent::Config.with_preview(
            edit_height: :lg,
            preview_class: "border border-card-border rounded-card px-3 py-3 mt-4"),
          rows: 4,
          placeholder: "Describe this game in markdown…",
          edit_class: "border border-input-border border-t-0 rounded-b-control px-3 py-2.5 text-base text-ink bg-card placeholder:text-muted-2") %>
  </div>

  <% if note? %>
    <p class="text-[11px] text-muted-2 m-0"><%= note %></p>
  <% end %>

  <div class="flex gap-2 pt-1">
    <%= f.submit submit_label, data: submit_data,
          class: "flex-1 bg-accent text-accent-ink rounded-control py-2.5 font-bold text-[13px] border-0 cursor-pointer" %>
    <%= link_to "Cancel", cancel_href,
          class: "flex-1 text-center border border-card-border text-ink rounded-control py-2.5 font-bold text-[13px] no-underline" %>
  </div>
<% end %>
