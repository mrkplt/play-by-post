<div class="bg-card border border-card-border rounded-card px-3.5">
  <% rows.each_with_index do |row, index| %>
    <%= render Ui::SettingsRowComponent.new(label: row.name, position: row_position(index)) do %>
    <% if row.token? %>
      <div class="min-w-0">
        <%= render Ui::SecretFieldComponent.new(value: row.secret_value, label: secret_label, revoke_path: row.revoke_path) %>
      </div>
    <% else %>
      <%= render Ui::ButtonComponent.new(
            style: Ui::ButtonComponent::Style.new(variant: :text, size: :sm),
            link: Ui::ButtonComponent::Link.new(url: row.create_path(scope), method: :post)) do %><%= create_label %><% end %>
    <% end %>
    <% end %>
  <% end %>
</div>
