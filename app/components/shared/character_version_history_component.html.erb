<details>
  <summary class="cursor-pointer font-semibold text-sm text-ink">Version History (<%= version_count %>)</summary>
  <div class="overflow-x-auto mt-2">
    <table class="w-full text-sm text-body-ink">
      <thead>
        <tr class="text-left text-muted">
          <th class="py-1 pr-4 font-semibold">Date</th>
          <th class="py-1 font-semibold">Edited by</th>
        </tr>
      </thead>
      <tbody>
        <% versions.each do |version| %>
          <tr class="border-t border-card-divider">
            <td class="py-1.5 pr-4"><%= link_to game_character_character_version_path(game, character, version), class: "text-accent no-underline" do %><time data-local-time="<%= version.created_at_iso8601 %>"><%= version.created_at_label %></time><% end %></td>
            <td class="py-1.5"><%= version.editor_name %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</details>
