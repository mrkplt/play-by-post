<div class="flex flex-col gap-3">
  <div class="flex items-center gap-3 justify-end">
    <%= link_to "Edit", edit_game_notebook_entry_path(game, notebook_entry), class: "text-xs font-semibold text-accent no-underline" %>
    <% unless promoted? %>
      <%= button_to "Promote", promote_game_notebook_entry_path(game, notebook_entry), method: :post,
            class: "text-xs font-semibold text-accent bg-transparent border-0 cursor-pointer p-0" %>
    <% end %>
    <%= button_to "Delete", game_notebook_entry_path(game, notebook_entry), method: :delete,
          form: { data: { turbo_confirm: "Delete this entry? This cannot be undone." } },
          class: "text-xs font-semibold text-danger bg-transparent border-0 cursor-pointer p-0" %>
  </div>

  <% if promoted? %>
    <%= link_to "Promoted to: #{promoted_page&.title}", game_page_path(game, T.must(promoted_page)),
          class: "text-xs font-semibold text-accent no-underline" %>
  <% end %>

  <div class="bg-card border border-card-border rounded-card p-4">
    <% if body? %>
      <%= render Ui::MarkdownRenderComponent.new(text: notebook_entry.body) %>
    <% else %>
      <p class="text-muted-2 m-0 text-sm">This entry has no content yet.</p>
    <% end %>
  </div>
</div>
