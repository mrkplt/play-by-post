<div id="<%= dom_id(notebook_entry) %>" class="<%= card_classes %>">
  <% if edit_mode? %>
    <%= form_with model: [ game, notebook_entry ], data: { turbo_stream: true }, class: "flex flex-col gap-2" do |f| %>
      <%= hidden_field_tag :inline, "1" %>
      <%= f.text_field :title, autofocus: true, placeholder: "Entry title",
            class: "w-full border border-input-border rounded-control px-2.5 py-2 text-sm text-ink bg-card placeholder:text-muted-2" %>

      <%= render Ui::MarkdownEditorComponent.new(
            form: f, field: :body,
            config: Ui::MarkdownEditorComponent::Config.new(scroll: :preview, preview_height: 160, rows: 6),
            placeholder: "Write the entry in markdown…",
            edit_class: "border border-input-border border-t-0 rounded-b-control px-2.5 py-2 text-sm text-ink bg-card placeholder:text-muted-2",
            preview_class: "border border-card-border rounded-card px-2.5 py-2 mt-2") %>

      <div class="flex gap-2 pt-1">
        <%= f.submit "Save", class: "flex-1 bg-accent text-accent-ink rounded-control py-2 font-bold text-[12px] border-0 cursor-pointer" %>
        <%= link_to "Cancel", game_notebook_entry_path(game, notebook_entry), data: { turbo_stream: true },
              class: "flex-1 text-center border border-card-border text-ink rounded-control py-2 font-bold text-[12px] no-underline" %>
      </div>
    <% end %>
  <% else %>
    <span class="text-sm font-bold text-ink"><%= notebook_entry.title %></span>

    <% if body? %>
      <%= render Ui::MarkdownRenderComponent.new(text: excerpt, content_class: "text-xs text-muted") %>
    <% else %>
      <p class="text-muted-2 m-0 text-xs">No content yet.</p>
    <% end %>

    <% if promoted? %>
      <%= link_to "Promoted to: #{promoted_page&.title}", game_page_path(game, T.must(promoted_page)),
            class: "text-xs font-semibold text-accent no-underline" %>
    <% end %>

    <%= form_with url: move_game_notebook_entry_path(game, notebook_entry), method: :patch, scope: :notebook_entry, data: { turbo_stream: true }, class: "flex items-center gap-2" do |f| %>
      <%= f.select :status, status_options, { selected: notebook_entry.status },
            onchange: "this.form.requestSubmit()",
            class: "border border-input-border rounded-control px-2 py-1.5 text-xs text-ink bg-card" %>
    <% end %>

    <div class="flex items-center gap-3">
      <%= link_to "Edit", edit_game_notebook_entry_path(game, notebook_entry), data: { turbo_stream: true },
            class: "text-xs font-semibold text-accent no-underline" %>
      <% unless promoted? %>
        <%= button_to "Promote", promote_game_notebook_entry_path(game, notebook_entry), method: :post, form: { data: { turbo_stream: true } },
              class: "text-xs font-semibold text-accent bg-transparent border-0 cursor-pointer p-0" %>
      <% end %>
      <%= button_to "Delete", game_notebook_entry_path(game, notebook_entry), method: :delete,
            form: { data: { turbo_confirm: "Delete this entry? This cannot be undone." } },
            class: "text-xs font-semibold text-danger bg-transparent border-0 cursor-pointer p-0" %>
    </div>
  <% end %>
</div>
