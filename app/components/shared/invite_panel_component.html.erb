<%# Wrapped in the stable DOM_ID so InvitationsController re-renders the whole
    panel in place after invite/cancel/resend (the pending list follows). %>
<div id="<%= Shared::InvitePanelComponent::DOM_ID %>">
  <%= render Ui::SectionLabelComponent.new(html_class: "mt-3") do %>Invite a Player<% end %>
  <%= form_with url: invite_url, method: :post, class: "flex gap-2 mt-1" do |f| %>
    <input type="email" name="invitation[email]" placeholder="player@email.com"
           class="flex-1 border border-input-border rounded-control px-2.5 py-2.5 text-xs text-ink bg-card placeholder:text-muted-2">
    <button type="submit" class="bg-accent text-accent-ink border-0 rounded-control px-4 font-extrabold text-xs cursor-pointer">Invite</button>
  <% end %>

  <% if pending? %>
    <%= render Ui::SectionLabelComponent.new(html_class: "mt-3") do %>Pending Invitations<% end %>
    <%= render Ui::CardComponent.new do %>
      <% pending_invitations.each_with_index do |inv, i| %>
        <%= render Ui::SettingsRowComponent.new(label: inv.email, sub: inv.sent_label, position: row_position(i)) do %>
          <div class="flex gap-3 items-center">
            <%= form_with url: inv.resend_path, method: :post, class: "inline" do |f| %>
              <%= f.submit "Resend", class: "text-[11px] font-bold text-accent bg-transparent border-0 cursor-pointer p-0" %>
            <% end %>
            <%= form_with url: inv.cancel_path, method: :delete, class: "inline" do |f| %>
              <%= f.submit "Cancel", class: "text-[11px] font-bold text-danger bg-transparent border-0 cursor-pointer p-0" %>
            <% end %>
          </div>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</div>
