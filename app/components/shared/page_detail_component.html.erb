<div class="flex flex-col gap-3">
  <% if can_manage? %>
    <div class="flex items-center gap-3 justify-end">
      <% if draft? %>
        <%= render Ui::BadgeComponent.new(variant: :slate) do %>Draft<% end %>
        <%= button_to "Publish", publish_path, method: :patch,
              class: "text-xs font-semibold text-accent bg-transparent border-0 cursor-pointer p-0" %>
      <% end %>
      <%= link_to "Edit", edit_game_page_path(game, page), class: "text-xs font-semibold text-accent no-underline" %>
      <%= button_to "Delete", game_page_path(game, page), method: :delete,
            form: { data: { turbo_confirm: "Delete this page? This cannot be undone." } },
            class: "text-xs font-semibold text-danger bg-transparent border-0 cursor-pointer p-0" %>
    </div>
  <% end %>

  <%= render Shared::TitledCardComponent.new(
        title: title, body: body, empty_notice: "This page has no content yet.") %>
</div>
