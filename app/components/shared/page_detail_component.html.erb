<div class="flex flex-col gap-3">
  <% if can_manage? %>
    <div class="flex items-center gap-3 justify-end">
      <%= link_to "Edit", edit_game_page_path(game, page), class: "text-xs font-semibold text-accent no-underline" %>
      <%= button_to "Delete", game_page_path(game, page), method: :delete,
            form: { data: { turbo_confirm: "Delete this page? This cannot be undone." } },
            class: "text-xs font-semibold text-danger bg-transparent border-0 cursor-pointer p-0" %>
    </div>
  <% end %>

  <div class="bg-card border border-card-border rounded-card p-4">
    <h1 class="text-lg font-bold text-ink m-0 mb-3"><%= title %></h1>
    <% if body? %>
      <%= render Ui::MarkdownRenderComponent.new(text: @page.body) %>
    <% else %>
      <p class="text-muted-2 m-0 text-sm">This page has no content yet.</p>
    <% end %>
  </div>
</div>
