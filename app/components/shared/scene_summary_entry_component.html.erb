<div class="bg-card border border-summary-slate-border rounded-lg p-5 mb-4">
  <div class="flex justify-between items-start mb-2">
    <h3 class="m-0 text-base font-semibold">
      <%= link_to scene_title, scene_path %>
    </h3>
    <% if formatted_resolved_at %>
      <span class="text-xs text-summary-slate-meta flex-shrink-0 ml-2">Resolved <%= formatted_resolved_at %></span>
    <% end %>
  </div>
  <%= render Ui::MarkdownRenderComponent.new(text: @summary.body, variant: :summary_slate) %>
</div>
