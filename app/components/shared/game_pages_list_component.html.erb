<div class="flex flex-col gap-3">
  <% if gm? %>
    <%= link_to "New Page", new_game_page_path(game),
          class: "block w-full text-center bg-accent text-accent-ink rounded-control py-2.5 font-bold text-[13px] no-underline" %>
  <% end %>

  <% if any_pages? %>
    <div class="bg-card border border-card-border rounded-card overflow-hidden">
      <% pages.each_with_index do |page, i| %>
        <div class="<%= row_classes(i) %>">
          <%= link_to game_page_path(game, page), class: "flex-1 min-w-0 no-underline" do %>
            <span class="block text-sm font-bold text-ink truncate"><%= page.title %></span>
          <% end %>

          <% if gm? %>
            <div class="flex items-center gap-3 flex-shrink-0">
              <%= link_to "Edit", edit_game_page_path(game, page), class: "text-xs font-semibold text-accent no-underline" %>
              <%= button_to "Delete", game_page_path(game, page), method: :delete,
                    form: { data: { turbo_confirm: "Delete this page? This cannot be undone." } },
                    class: "text-xs font-semibold text-danger bg-transparent border-0 cursor-pointer p-0" %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="text-muted-2 text-sm">No pages yet.</p>
  <% end %>
</div>
