<div class="flex flex-col gap-3" id="<%= Shared::ContentTemplatesListComponent::DOM_ID %>">
  <div class="flex items-center justify-between">
    <p class="text-sm text-muted-2 m-0"><%= INTRO %></p>
    <% if can_add? %>
      <%= link_to "New Template", new_game_content_template_path(game), class: "text-xs font-semibold text-accent no-underline" %>
    <% end %>
  </div>

  <%= render Shared::ListEntryComponent.new(rows: rows, empty_text: EMPTY) %>
</div>
