<div class="bg-card border border-card-border rounded-card px-3.5">
  <% rows.each_with_index do |row, index| %>
    <%= render Ui::SettingsRowComponent.new(label: row.game_name, last: last_row?(row, index)) do %>
    <% if row.token %>
      <div class="flex flex-col items-end gap-2 min-w-0">
        <%= render Ui::SecretFieldComponent.new(value: feed_url(row.token), label: "Feed URL") %>
        <%= button_to "Revoke", profile_api_token_path(row.token), method: :delete,
              class: "text-xs font-bold text-accent bg-transparent border-0 cursor-pointer p-0" %>
      </div>
    <% else %>
      <%= button_to "Create feed", profile_api_tokens_path, method: :post,
            params: { game_id: row.game_id, scope: "rss" },
            class: "text-xs font-bold text-accent bg-transparent border-0 cursor-pointer p-0" %>
      <% end %>
    <% end %>
  <% end %>
</div>
