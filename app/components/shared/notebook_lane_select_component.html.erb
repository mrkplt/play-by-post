<%= form_with url: move_game_notebook_entry_path(game, notebook_entry), method: :patch, scope: :notebook_entry, data: { turbo_stream: true }, class: "flex items-center gap-2" do |f| %>
  <%= f.label :status, "Lane", class: "sr-only" %>
  <%= f.select :status, status_options, { selected: selected_status },
        onchange: "this.form.requestSubmit()",
        class: Shared::NotebookLaneSelectComponent::SELECT_CLASS %>
<% end %>
