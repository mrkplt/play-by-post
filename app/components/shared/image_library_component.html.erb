<section class="flex flex-col gap-3" data-testid="image-library" data-controller="image-select">
  <%= render Ui::SectionLabelComponent.new do %><%= title %><% end %>

  <% if any_images? %>
    <div class="<%= populated_card_class %>">
      <% if (current = current_image) %>
        <div class="flex justify-center">
          <%= image_tag current[:display_url],
                class: "w-40 h-40 rounded-card object-cover border border-card-border",
                alt: "Current image", data: { testid: "current-image", image_select_target: "current" } %>
        </div>
      <% end %>

      <div class="flex flex-wrap gap-3">
        <% images.each do |image| %>
          <div class="flex flex-col items-center gap-1" data-testid="library-item">
            <%= image_tag image[:thumb_url], class: image_thumb_class(image), alt: "Library image",
                  data: thumb_data(image) %>
            <% if can_manage %>
              <%= button_to "Delete", image[:delete_url], method: :delete,
                    form: { data: { turbo_confirm: "Delete this image?" } },
                    class: "text-[11px] font-bold text-danger cursor-pointer bg-transparent border-0 p-0",
                    data: { testid: "delete-image" } %>
            <% end %>
          </div>
        <% end %>
      </div>

      <% if can_manage %>
        <div class="flex justify-end">
          <button type="button" class="<%= Shared::ImageLibraryComponent::SAVE_BUTTON_CLASS %>"
                  data-image-select-target="save" data-action="click->image-select#save"
                  data-testid="save-image-selection" disabled>Save</button>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="<%= Shared::ImageLibraryComponent::CARD_CLASS %>">
      <p class="text-muted-2 m-0 text-sm"><%= empty_text %></p>
    </div>
  <% end %>
</section>
