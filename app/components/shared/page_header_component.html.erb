<header class="bg-sidebar-bg px-3 py-2 flex items-center gap-0.5">
  <% if back? %>
    <%= render Ui::IconButtonComponent.new(href: back_href, label: "Back") do %>
      <span class="text-2xl leading-none">&larr;</span>
    <% end %>
  <% else %>
    <%= render Ui::IconButtonComponent.new(
          label: "Open navigation",
          html_options: { data: { action: "click->sidebar#open" } }) do %>
      <span class="text-2xl leading-none">&#9776;</span>
    <% end %>
  <% end %>
  <h1 class="<%= title_classes %>"><%= title %></h1>
</header>
