<%= form_with model: [  @game, @scene, @post  ],
    multipart: true,
    data: {
      controller: "post-draft",
      post_draft_save_url_value: save_draft_game_scene_posts_path(@game, @scene)
    } do |f| %>
  <% if @post.errors.any? %>
    <div class="bg-red-50 border border-red-300 rounded-lg px-3 py-2 mb-3 text-sm text-red-600">
      <% @post.errors.full_messages.each do |msg| %>
        <div><%= msg %></div>
      <% end %>
    </div>
  <% end %>

  <%= render Ui::SectionLabelComponent.new(html_class: "mb-2") do %>Post a Reply<% end %>

  <%= render Ui::MarkdownEditorComponent.new(
        form: f, field: :content,
        config: Ui::MarkdownEditorComponent::Config.with_preview(
          preview_class: "post-content border border-card-border rounded-control px-3 py-3 mt-3"),
        value: @draft&.content.to_s,
        placeholder: "Write your post... (markdown)",
        data: {
          post_draft_target: "content",
          action: "input->markdown-preview#update input->post-draft#scheduleSave"
        },
        edit_class: "px-2.5 py-2 border border-input-border border-t-0 rounded-b-control text-base",
        wrapper_class: "mb-3") %>

  <% unless @game.images_disabled? %>
    <div class="mb-2">
      <%= f.label :image, "Image (optional)", class: "block font-medium mb-1 text-sm text-row-ink" %>
      <%= f.file_field :image, accept: "image/jpeg,image/png,image/gif,image/webp",
          class: "block max-w-md text-sm text-row-ink border border-input-border rounded-control px-3 py-2 cursor-pointer bg-white file:mr-3 file:py-1 file:px-3 file:rounded file:border-0 file:text-sm file:font-medium file:bg-slate-100 file:text-slate-700 hover:file:bg-slate-200" %>
      <p class="text-xs text-muted-2 mt-0.5">JPEG, PNG, GIF, or WebP. Max 10MB.</p>
    </div>
  <% end %>

  <div class="flex justify-between items-center flex-wrap gap-2" data-testid="composer-actions">
    <div class="flex gap-2 items-center">
      <label class="flex items-center gap-[7px] text-[13px] text-row-ink font-semibold px-2.5 py-2 rounded-control cursor-pointer">
        <%= f.check_box :is_ooc, class: "w-[18px] h-[18px] accent-accent" %>
        OOC
      </label>
      <label class="flex items-center gap-1.5 text-[13px] text-row-ink font-semibold px-2.5 py-2 rounded-control cursor-pointer">
        <input type="checkbox" class="w-[18px] h-[18px] accent-accent" data-post-draft-target="saveAsDraftToggle" data-action="change->post-draft#toggleSaveAsDraft">
        Save as draft
      </label>
      <span data-post-draft-target="status" class="text-xs text-muted-2 hidden"></span>
    </div>
    <%= f.submit "POST", class: "bg-accent text-accent-ink border-0 rounded-control px-5 py-2.5 font-extrabold text-[13px] tracking-[0.02em] cursor-pointer", style: "min-height: 44px;" %>
  </div>
<% end %>
