<%= form_with model: [  @game, @scene, @post  ],
    data: {
      controller: "draft",
      draft_save_url_value: @scene.routes.save_draft_url,
      draft_publish_label_value: "POST"
    } do |f| %>
  <% if @post.errors.any? %>
    <div class="bg-error-bg border border-error-border-strong rounded-lg px-3 py-2 mb-3 text-sm text-error-text">
      <% @post.errors.full_messages.each do |msg| %>
        <div><%= msg %></div>
      <% end %>
    </div>
  <% end %>

  <%= render Ui::SectionLabelComponent.new(html_class: "mb-2") do %>Post a Reply<% end %>

  <%= render Ui::MarkdownEditorComponent.new(
          binding: { form: f, field: :content },
          config: Ui::MarkdownEditorComponent::Config.with_preview(content_class: "post-content"),
          field: Ui::MarkdownEditorComponent::Field.new(value: @draft&.content, placeholder: "Write your post... (markdown)", data: {
          draft_target: "content",
          action: "input->markdown-preview#update input->draft#scheduleSave"
        }, wrapper_class: "mb-3")) %>

  <div class="flex justify-between items-center flex-wrap gap-2" data-testid="composer-actions">
    <div class="flex gap-2 items-center">
      <label class="flex items-center gap-[7px] text-[13px] text-row-ink font-semibold px-2.5 py-2 rounded-control cursor-pointer">
        <%= f.check_box :is_ooc, class: "w-[18px] h-[18px] accent-accent" %>
        OOC
      </label>
      <label class="flex items-center gap-1.5 text-[13px] text-row-ink font-semibold px-2.5 py-2 rounded-control cursor-pointer">
        <input type="checkbox" class="w-[18px] h-[18px] accent-accent" data-draft-target="saveAsDraftToggle" data-action="change->draft#toggleSaveAsDraft">
        Save as draft
      </label>
      <span data-draft-target="status" class="text-xs text-muted-2 hidden"></span>
    </div>
    <%= f.submit "POST", class: "bg-accent text-accent-ink border-0 rounded-control px-5 py-2.5 font-extrabold text-[13px] tracking-[0.02em] cursor-pointer", style: "min-height: 44px;" %>
  </div>
<% end %>
