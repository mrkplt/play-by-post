<div id="<%= wrapper_id %>">
  <% if row? %>
    <%= render Ui::SettingsRowComponent.new(
          label: "AI Scene Summaries", sub: "Auto-summarize when scenes resolve", position: :last) do %>
      <%= button_to toggle_path, method: :patch, class: "bg-transparent border-0 p-0 cursor-pointer",
            "aria-label": toggle_label do %>
        <%= render Ui::ToggleSwitchComponent.new(state: toggle_switch_state) %>
      <% end %>
    <% end %>
  <% else %>
    <%= render Shared::SettingCardComponent.new(
          title: "AI Scene Summaries", toggle_label: toggle_label, toggle_path: toggle_path) do %>
      AI summaries are currently <strong class="text-ink"><%= status_text %></strong>.
      A summary is generated automatically each time a scene resolves.
    <% end %>
  <% end %>
</div>
