<div data-feedback-target="modal" hidden data-testid="feedback-modal"
     class="fixed inset-0 z-[1000] flex items-center justify-center p-4"
     data-action="click->feedback#closeOnBackdrop keydown@document->feedback#closeOnEscape">
  <div class="absolute inset-0 bg-black/60" data-feedback-backdrop></div>
  <div class="relative bg-card rounded-card w-full max-w-3xl max-h-[86vh] flex flex-col overflow-hidden">
    <%# Form panel — submitted via fetch so the page never navigates. %>
    <div data-feedback-target="formPanel">
      <%= form_with url: submit_path, scope: :feedback, method: :post,
            data: { action: "submit->feedback#submit" },
            class: "p-5 flex flex-col gap-3 overflow-y-auto min-h-0" do |form| %>
        <h2 class="text-lg font-semibold text-row-ink">Send Feedback</h2>
        <p class="text-sm text-muted-2">
          Tell us what's working, what's broken, or what you'd like to see. We'll
          note the page you're on. Markdown is supported.
        </p>
        <%= form.hidden_field :url, data: { feedback_target: "url" } %>
        <%= render Ui::MarkdownEditorComponent.new(
              binding: { form: form, field: :body },
              config: Ui::MarkdownEditorComponent::Config.new(
                edit_height: :md,
                regions: [ Ui::MarkdownEditorComponent::ToolbarRegion.new ]),
              placeholder: "Your feedback…",
              required: true,
              data: { feedback_target: "field" }) %>
        <p data-feedback-target="error" hidden class="text-sm text-danger">
          Something went wrong. Please try again.
        </p>
        <%= render Ui::TurnstileWidgetComponent.new(action: "feedback") %>
        <div class="flex justify-end gap-2 mt-1">
          <button type="button" data-action="click->feedback#close"
                  class="px-4 py-2 border border-card-border text-row-ink rounded text-sm cursor-pointer">
            Cancel
          </button>
          <%= form.submit "Submit",
                class: "px-4 py-2 bg-accent text-accent-ink rounded text-sm cursor-pointer" %>
        </div>
      <% end %>
    </div>

    <%# Success panel — shown in place after a successful submit, no reload. %>
    <div data-feedback-target="successPanel" hidden class="p-5 flex flex-col gap-3">
      <h2 class="text-lg font-semibold text-row-ink">Thanks for your feedback!</h2>
      <p class="text-sm text-muted-2">We've got it — it helps us make the game better.</p>
      <div class="flex justify-end mt-1">
        <button type="button" data-action="click->feedback#close"
                class="px-4 py-2 bg-accent text-accent-ink rounded text-sm cursor-pointer">
          Close
        </button>
      </div>
    </div>
  </div>
</div>
