<%# A Turbo Frame that subscribes to a signed Turbo Stream and waits. While the
    backend job is still running the frame shows a spinner; when the worker
    finishes it broadcasts a turbo_stream.replace targeting this frame id, and
    Turbo swaps the finished content in place for every subscribed viewer. The
    completion toast rides its own broadcast (see the worker) into #toast_layer. %>
<%= helpers.turbo_stream_from(*streamables, **stream_options) %>
<%= helpers.turbo_frame_tag(frame_id) do %>
  <div class="flex items-center gap-3 text-muted-2 py-4">
    <%= render Ui::SpinnerComponent.new(size: :sm, label: message) %>
    <span class="text-sm"><%= message %></span>
  </div>
<% end %>
