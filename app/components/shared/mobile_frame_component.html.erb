<div class="app-frame">
  <% if header? %>
    <%= header %>
  <% end %>

  <div class="app-body">
    <%= content %>
  </div>

  <% if footer? %>
    <%# Last child of the non-scrolling frame column, so it stays pinned below the
        scrolling body without `position: sticky` (which the frame's overflow
        clipping would break). shrink-0 keeps it from being squeezed by a tall body. %>
    <footer class="shrink-0 border-t border-card-border bg-card px-4 py-3">
      <%= footer %>
    </footer>
  <% end %>
</div>
