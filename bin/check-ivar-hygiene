#!/usr/bin/env ruby
# frozen_string_literal: true

# Ratchets instance-variable hygiene toward: initializers assign ivars, methods
# read through accessors, and no accessor is declared that nobody uses.
#
# Three violation kinds are checked per file, enforced tree-wide: every .rb file
# under app/ and lib/ must have zero. (This started as a progressive ratchet that
# only forbade a changed file from INCREASING its count vs origin/master, so it
# could land before the backlog was swept. That sweep is done — the tree is at
# zero — so the scope is retired: any violation anywhere fails.)
#
#   V1  ivar WRITE outside #initialize.
#       An initializer sets up state; other methods should not reassign ivars.
#       `@x ||= ...` (idiomatic lazy memoization) is exempt — it is a one-time
#       initialization, not mutation of established state.
#
#   V2  ivar READ in a method when a matching attr_reader/attr_accessor exists.
#       If the class declares `attr_reader :x`, methods must call `x`, not `@x`.
#       Reading `@x` where the reader exists bypasses the seam for no reason.
#
#   V3  attr_reader/attr_writer/attr_accessor declared but never USED — not in
#       the class's own Ruby methods and not in the paired ViewComponent ERB
#       template (checked by a text scan of the sibling .html.erb). An accessor
#       nothing calls is dead surface area; delete it (and, if it was the only
#       reader for an ivar only set in initialize, keep the ivar).
#
# Every .rb file under app/ and lib/ is inspected. ERB is not Ruby-parsed here;
# it is only text-scanned to keep V3 from flagging a reader that a template uses.

require "prism"

ROOT = File.expand_path("..", __dir__)

IVAR_WRITE_NODES = [
  Prism::InstanceVariableWriteNode,
  Prism::InstanceVariableOperatorWriteNode,
  Prism::InstanceVariableAndWriteNode,
  Prism::InstanceVariableTargetNode, # multiple-assignment target: @a, @b = ...
].freeze
# NB: InstanceVariableOrWriteNode (`@x ||= ...`) is deliberately absent — it is
# exempt memoization, treated as lazy initialization rather than mutation.

# V3 allowlist: readers that ARE used, but only from other files, so the
# per-file V3 scan cannot see the use and would wrongly call them dead. Keyed by
# "relative/path.rb" => [reader names], each with a stated reason. Keep this
# empty unless a reader is genuinely consumed across a class boundary — an
# in-file dead reader must still be deleted, not allowlisted.
#
#   app/policies/application_policy.rb — the Pundit base class exposes user,
#   record (and scope, on the inner Scope base) as the contract every policy
#   subclass reads as bare `record` / `user` / `scope`. The readers live on the
#   base and every use is in a subclass file; deleting them breaks all policies.
V3_ALLOWLIST = {
  "app/policies/application_policy.rb" => %i[user record scope]
}.freeze

def each_def(node, &block)
  return if node.nil?
  block.call(node) if node.is_a?(Prism::DefNode)
  node.compact_child_nodes.each { |child| each_def(child, &block) }
end

# Prism reports ivar node names with the leading `@` (e.g. :@notice); accessor
# declarations use the bare symbol (:notice). Normalize to the bare form so the
# two compare.
def bare_ivar(name)
  name.to_s.delete_prefix("@").to_sym
end

def ivar_writes(node, into)
  return if node.nil?
  into << bare_ivar(node.name) if IVAR_WRITE_NODES.any? { |klass| node.is_a?(klass) }
  node.compact_child_nodes.each { |child| ivar_writes(child, into) }
end

def ivar_reads(node, into)
  return if node.nil?
  into << bare_ivar(node.name) if node.is_a?(Prism::InstanceVariableReadNode)
  node.compact_child_nodes.each { |child| ivar_reads(child, into) }
end

# attr_reader/attr_writer/attr_accessor declarations -> { name => [:reader, ...] }
# recording which access methods each ivar name got.
def declared_accessors(root)
  accessors = Hash.new { |hash, key| hash[key] = [] }
  walk_accessor_calls(root) do |kind, names|
    names.each { |name| accessors[name] << kind }
  end
  accessors
end

def walk_accessor_calls(node, &block)
  return if node.nil?
  if node.is_a?(Prism::CallNode) && node.receiver.nil? &&
     %i[attr_reader attr_writer attr_accessor].include?(node.name) && node.arguments
    names = node.arguments.arguments.filter_map do |arg|
      arg.is_a?(Prism::SymbolNode) ? arg.unescaped.to_sym : nil
    end
    block.call(node.name, names)
  end
  node.compact_child_nodes.each { |child| walk_accessor_calls(child, &block) }
end

# Method names invoked with no explicit receiver anywhere in the file — used to
# tell whether a declared reader/writer is called from the class's own methods.
def bare_method_calls(node, into)
  return if node.nil?
  into << node.name if node.is_a?(Prism::CallNode) && node.receiver.nil?
  node.compact_child_nodes.each { |child| bare_method_calls(child, into) }
end

# Every method-call NAME sent in the source, with any receiver. V2 wants
# bare-receiver calls only (a bare `x` is the reader call), but V3's "is this
# accessor used at all" question is answered by a call with any receiver too: a
# reader exposed for external access is legitimately read as `obj.height`, not
# only as a bare `height`. Collecting these keeps V3 from flagging a reader used
# only through an explicit receiver — e.g. a nested Config's attr_reader read as
# `@config.height` by the enclosing component in the same file.
def all_call_names(node, into)
  return if node.nil?
  into << node.name if node.is_a?(Prism::CallNode)
  node.compact_child_nodes.each { |child| all_call_names(child, into) }
end

# Names referenced in the paired ViewComponent template (app/.../x_component.rb
# -> app/.../x_component.html.erb). Plain word scan: enough to see that a reader
# is used from the template without parsing ERB.
def template_words(rb_path)
  erb_path = rb_path.sub(/\.rb\z/, ".html.erb")
  return [] unless File.exist?(erb_path)
  File.read(erb_path, encoding: "utf-8").scan(/[a-z_][a-z0-9_]*[?!]?/i)
end

def accessor_method_names(name, kinds)
  names = []
  names << name if kinds.include?(:attr_reader) || kinds.include?(:attr_accessor)
  names << :"#{name}=" if kinds.include?(:attr_writer) || kinds.include?(:attr_accessor)
  names
end

# Returns the violation lines for one Ruby source file.
# V1 does not apply to framework-instantiated action classes: controllers,
# mailers, and mailboxes. The rule reads "an initializer sets up state; other
# methods should not reassign ivars", which presumes a class you instantiate
# yourself. Rails instantiates these per request / per message and there is no
# #initialize to assign in — every action that hands data to its view or
# processing writes an ivar there by the framework's design, so V1 is
# unsatisfiable rather than unmet (a mailer action sets @ivars for the mail
# view; a mailbox sets them across its processing helpers). For controllers it
# also collides head-on with bin/check-view-layering, which requires every
# view-facing ivar to be a presenter built in the action. V2 and V3 still apply
# to all three; only the write-location rule is exempt.
def framework_action_class?(rb_path)
  path = rb_path.to_s
  path.include?("app/controllers/") ||
    path.include?("app/mailers/") ||
    path.include?("app/mailboxes/")
end

def violations_for(source, rb_path)
  root = Prism.parse(source).value
  accessors = declared_accessors(root)
  reader_names = accessors.select { |_, kinds| kinds.include?(:attr_reader) || kinds.include?(:attr_accessor) }.keys
  calls = [].tap { |into| bare_method_calls(root, into) }
  received_calls = [].tap { |into| all_call_names(root, into) }
  words = template_words(rb_path)

  found = []
  ivars_read_directly = []

  each_def(root) do |defn|
    method_name = defn.name

    writes = [].tap { |into| ivar_writes(defn, into) }.uniq
    unless method_name == :initialize || framework_action_class?(rb_path)
      writes.each { |name| found << "V1 writes @#{name} in ##{method_name} (assign ivars in #initialize only)" }
    end

    reads = [].tap { |into| ivar_reads(defn, into) }.uniq
    ivars_read_directly.concat(reads)
    reads.each do |name|
      if reader_names.include?(name)
        found << "V2 reads @#{name} in ##{method_name} though attr_reader :#{name} exists (use the reader: `#{name}`)"
      end
    end
  end

  accessors.each do |name, kinds|
    methods = accessor_method_names(name, kinds)
    used = methods.any? do |m|
      calls.include?(m) ||
        received_calls.include?(m) ||
        words.include?(m.to_s.delete_suffix("="))
    end
    # Don't call an accessor "unused" (V3) when the code reads @name directly:
    # that is the V2 case (the ivar IS wanted through the reader), and the fix is
    # to route through the accessor, not to delete it. Flagging both is
    # contradictory advice for the same declaration.
    next if used || ivars_read_directly.include?(name)

    relative = rb_path.to_s.sub("#{ROOT}/", "")
    next if V3_ALLOWLIST.fetch(relative, []).include?(name)

    decl = kinds.uniq.first
    found << "V3 #{decl} :#{name} is declared but never used (in a method or the template); remove it"
  end

  found
end

def ruby_files
  Dir.glob(File.join(ROOT, "{app,lib}/**/*.rb")).sort
end

failures = []

ruby_files.each do |path|
  relative = path.delete_prefix("#{ROOT}/")
  violations = violations_for(File.read(path, encoding: "utf-8"), path)
  failures << [ relative, violations ] unless violations.empty?
end

if failures.empty?
  puts "Ivar-hygiene check: OK (no ivar-hygiene violations under app/ or lib/)"
  exit 0
else
  puts "Ivar-hygiene check: FAIL\n\n"
  failures.each do |relative, list|
    puts "  #{relative}:"
    list.each { |line| puts "    - #{line}" }
    puts
  end
  puts <<~REMEDY
    A file has an ivar-hygiene violation. Resolve by:
      V1  Move the assignment into #initialize (or, if it is lazy setup, use the
          `@x ||= ...` memoization form, which is exempt).
      V2  Declare/keep `attr_reader :x` and call `x` in the method instead of `@x`.
      V3  Delete the unused accessor declaration (or, if it is genuinely used
          only from another file, add it to V3_ALLOWLIST with a stated reason).
  REMEDY
  exit 1
end
