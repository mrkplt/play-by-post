#!/usr/bin/env ruby
# frozen_string_literal: true

# Design-token adherence check (self-contained; owns its own pass/fail).
#
# Raw hex colours in Tailwind arbitrary-value class utilities (e.g. bg-[#c8a96e])
# must never appear in application source. Every colour must be a named @theme
# token (bg-accent, text-tint-blue-strong, …). Two reasons, one rule:
#
#   - In ERB templates, an arbitrary-hex utility bypasses the @theme tokens.
#   - In Ruby component classes and JS Stimulus controllers, Tailwind v4's
#     content scanner does NOT reliably extract arbitrary values from string
#     literals, so the utility is never compiled into the stylesheet at all —
#     the element renders with no colour. This is exactly how the OOC toggle,
#     avatar, and badge tones shipped invisible (Fizzy #59). Parking the raw
#     palette in .rb tone tables was NOT sanctioned — it was silently broken.
#     See context/DESIGN_TOKEN_COMPILATION.md.
#
# Scope: ERB templates (app/views, app/components), component Ruby classes
# (app/components), and Stimulus controllers (app/javascript). @theme token
# DEFINITIONS in the Tailwind stylesheet (--color-x: #hex) are the sanctioned
# home for raw hex and are not scanned.
#
# Exits 0 when clean, 1 when any violation is found.

PROJECT_ROOT = File.expand_path("..", __dir__)

# The banned token: a Tailwind arbitrary-value colour utility, e.g. bg-[#3a3c42],
# text-[#e28a8a], border-[#5c2121]. Matched wherever it appears, not only inside
# class="..." — because in .rb/.js it lives in a bare string literal.
RAW_HEX_CLASS_RE = /\b(?:bg|text|border|from|via|to|ring|fill|stroke|decoration|outline|shadow|accent|caret)-\[#[0-9a-fA-F]{3,8}\]/

scanned_files = Dir.glob(File.join(PROJECT_ROOT, "app/views/**/*.html.erb")) +
                Dir.glob(File.join(PROJECT_ROOT, "app/components/**/*.html.erb")) +
                Dir.glob(File.join(PROJECT_ROOT, "app/components/**/*.rb")) +
                Dir.glob(File.join(PROJECT_ROOT, "app/javascript/**/*.js"))

violations = []
scanned_files.each do |file|
  content = File.read(file, encoding: "utf-8")
  hits = content.scan(RAW_HEX_CLASS_RE)
  next if hits.empty?

  violations << { file: file.delete_prefix("#{PROJECT_ROOT}/"), hits: hits }
rescue Encoding::InvalidByteSequenceError, Encoding::UndefinedConversionError
  # skip non-UTF-8 files
end

if violations.empty?
  puts "[OK] design tokens: no raw hex colour utilities in ERB / component Ruby / JS"
  exit 0
end

count = violations.sum { |v| v[:hits].size }
warn "[FAIL] design tokens: #{count} raw hex colour utility(ies) found."
warn "       Replace each with a named @theme token (e.g. bg-[#3a3c42] -> bg-pill-idle)."
warn "       In .rb/.js these never compile into the stylesheet — see"
warn "       context/DESIGN_TOKEN_COMPILATION.md."
violations.each do |v|
  warn "  #{v[:file]}: #{v[:hits].uniq.join(', ')}"
end
exit 1
