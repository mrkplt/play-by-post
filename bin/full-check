#!/bin/bash
# Full local pipeline, on demand — everything CI runs on a PR.
#
# The pre-push hook (bin/pre-push) covers only the fast tier: static checks
# plus non-system specs. Run this instead when you want the complete verdict
# locally without waiting on CI — before opening a PR, after touching
# mutation-sensitive code, or when CI is the bottleneck. Expect several
# minutes: system specs (~90s) and mutation testing (~3-4 min) dominate.
#
# "Everything CI runs" means matching CI's environment, not just its commands.
# This used to force Homebrew ruby onto PATH — whatever version Homebrew last
# installed (4.0.2 here), not the .ruby-version CI pins (3.3.6), which is also
# what the vendored gems are built for. Bootstrap rbenv the way bin/pre-push
# does so both tiers run on the pinned interpreter. (Eager loading is no longer
# an axis of divergence: config/environments/test.rb enables it unconditionally
# rather than keying it off ENV["CI"].)
export PATH="/opt/homebrew/bin:$PATH"
if command -v rbenv >/dev/null 2>&1; then
  eval "$(rbenv init - bash)"
fi

if bin/docs-only; then
  echo "==> Docs-only change: nothing to check."
  exit 0
fi

bin/pre-push || exit 1

echo "==> Full test suite (rspec incl. system specs + coverage)"
bundle exec rspec || exit 1

echo "==> Mutation testing (mutant --since origin/master)"
MUTANT_OUTPUT=$(mktemp)
bundle exec mutant run --usage opensource --since origin/master 2>&1 | tee "$MUTANT_OUTPUT"
bin/quality-metrics --record-mutant "$MUTANT_OUTPUT"
rm -f "$MUTANT_OUTPUT"
rm -f storage/test_worker_*.sqlite3

echo "==> Quality metrics check"
bin/quality-metrics --check || exit 1

echo "Full pipeline passed — matches what CI will run on the PR."
