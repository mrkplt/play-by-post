#!/usr/bin/env ruby
# frozen_string_literal: true

# Ratchets Ruby file length toward a 100-line ceiling.
#
# A long file is doing too many things; the remedy is always to split it — pull
# a cohesive slice into its own class/module/component/presenter and delegate.
# The limit here is 100 *code* lines (blank lines and comment-only lines do not
# count, so documentation and breathing room are free), matching the project's
# preference for small, single-purpose units.
#
# Incremental by design, two rules against origin/master:
#   1. A file NEW on this branch (absent from master) must be <= LIMIT outright.
#   2. A file that already existed may not INCREASE its code-line count, even if
#      it is already over LIMIT — pre-existing long files are grandfathered but
#      frozen, so the number can only go down. (Same "must not increase" ratchet
#      as the controller-ivar / CSS / ERB-logic gates.)
#
# Only files added or modified vs origin/master are inspected. The ratchet is
# meant to be retired once the grandfathered files are split, enforcing the flat
# 100-line ceiling everywhere.

require "prism"

ROOT = File.expand_path("..", __dir__)
LIMIT = 100

# Code lines = lines that are not blank and not comment-only. Prism gives us the
# exact set of lines occupied by comments (including the inner lines of a
# =begin/=end block and trailing `# ...` comments); subtract those, then drop
# blank lines. A trailing comment on a line of code still leaves that line
# counted, because the line also carries code.
def code_line_count(source)
  return 0 if source.strip.empty?

  result = Prism.parse(source)
  lines = source.lines

  comment_only_lines = comment_only_line_numbers(result, lines)

  (1..lines.length).count do |number|
    line = lines[number - 1]
    next false if line.nil? || line.strip.empty?      # blank
    next false if comment_only_lines.include?(number) # comment-only

    true
  end
end

# 1-based line numbers whose entire content is a comment (nothing but a comment
# token sits on them). A `code # trailing` line is NOT comment-only.
def comment_only_line_numbers(result, lines)
  code_lines = code_bearing_line_numbers(result.value)
  commented = result.comments.flat_map do |comment|
    loc = comment.location
    (loc.start_line..loc.end_line).to_a
  end
  commented.uniq.reject { |number| code_lines.include?(number) }.to_set
end

# Every 1-based line number touched by a non-comment AST node — i.e. lines that
# carry actual code. Used to tell a comment-only line from a code line that also
# has a trailing comment.
def code_bearing_line_numbers(node, into = Set.new)
  return into if node.nil?

  loc = node.location
  (loc.start_line..loc.end_line).each { |number| into << number } if loc
  node.compact_child_nodes.each { |child| code_bearing_line_numbers(child, into) }
  into
end

def changed_ruby_files
  tracked = `git -C #{ROOT} diff --name-only --diff-filter=AM origin/master`.lines.map(&:strip)
  untracked = `git -C #{ROOT} ls-files --others --exclude-standard`.lines.map(&:strip)
  (tracked + untracked)
    .grep(%r{\A(?:app|lib)/.*\.rb\z})
    .uniq
    .map { |relative| File.join(ROOT, relative) }
    .select { |path| File.exist?(path) }
end

failures = []
reported = false

changed_ruby_files.each do |path|
  relative = path.delete_prefix("#{ROOT}/")
  new_count = code_line_count(File.read(path, encoding: "utf-8"))

  old_source = `git -C #{ROOT} show origin/master:#{relative} 2>/dev/null`.force_encoding("utf-8")

  if old_source.strip.empty?
    # New file — must meet the ceiling outright.
    reported = true
    status = new_count > LIMIT ? "FAIL" : "OK"
    puts "  [#{status}] #{relative}: #{new_count} code lines (new file, limit #{LIMIT})"
    if new_count > LIMIT
      failures << "#{relative}: new file has #{new_count} code lines (limit #{LIMIT}); " \
                  "split it into smaller single-purpose units"
    end
  else
    # Existing file — grandfathered, but must not grow.
    old_count = code_line_count(old_source)
    delta = new_count - old_count
    reported = true
    status = delta > 0 && new_count > LIMIT ? "FAIL" : "OK"
    puts "  [#{status}] #{relative}: #{old_count} -> #{new_count} code lines (#{delta >= 0 ? '+' : ''}#{delta})"
    if delta > 0 && new_count > LIMIT
      failures << "#{relative}: grew to #{new_count} code lines (was #{old_count}, limit #{LIMIT}); " \
                  "this file is over the ceiling and may not grow — extract the new code into its own unit"
    end
  end
end

if !reported
  puts "File-length check: OK (no changed Ruby files to ratchet)"
  exit 0
elsif failures.empty?
  puts "\nFile-length check: OK (no file exceeded the ceiling or grew past it)"
  exit 0
else
  puts "\nFile-length check: FAIL\n\n"
  failures.each { |line| puts "  #{line}" }
  puts <<~REMEDY

    Files must be <= #{LIMIT} code lines (blank + comment-only lines don't count).
    To resolve, split the file — do not just move code out of sight:
      - A controller too long usually means an action's work belongs in a
        service/model; extract it and call it.
      - A component/presenter too long usually holds more than one concern;
        pull the extra concern into its own component/presenter.
      - A model too long usually means a cohesive cluster of methods wants to be
        a plainly-included module (not a concern) or a service.
    Grandfathered files already over #{LIMIT} may shrink freely but must not grow.
  REMEDY
  exit 1
end
