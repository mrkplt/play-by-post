#!/bin/bash
# Fast local gate — static checks + non-system specs only (~30-40s).
#
# System specs (type: :feature, Capybara+Playwright) are ~85% of the suite's
# wall time for ~15% of its examples, and mutation testing / the full
# quality-metrics gate need data from a full run anyway — none of that is
# worth paying for on every push. The heavy tier runs in CI on every PR, or
# locally on demand via bin/full-check — your call which to wait on. This
# hook exists to catch obvious breaks fast, not to duplicate the full
# pipeline.
#
# Git hooks run outside an interactive shell, so rbenv (which sets up the
# .ruby-version shims) is not initialized here. Bootstrap it explicitly so the
# checks run on the project's pinned interpreter instead of whatever Homebrew
# ruby happens to be first in PATH — the vendored gems are built for the
# .ruby-version ruby, not the Homebrew default.
export PATH="/opt/homebrew/bin:$PATH"
if command -v rbenv >/dev/null 2>&1; then
  eval "$(rbenv init - bash)"
fi

if bin/docs-only; then
  echo "==> Docs-only change: skipping pre-push checks (CI will no-op them too)."
  exit 0
fi

echo "Running fast checks before push (system specs, mutation, and the full quality gate run in CI on the PR)..."

echo "==> Lint (rubocop)"
bin/rubocop || exit 1

echo "==> Design-token adherence (no raw hex in ERB)"
bin/check-design-tokens || exit 1

echo "==> Mutant coverage registration check"
bin/check-mutant-coverage || exit 1

echo "==> Stateless services are modules (service-module check)"
bin/check-service-modules || exit 1

echo "==> Policy coverage (every authorizable model has a policy)"
bin/check-policy-coverage || exit 1

echo "==> Authorization net (every controller installs verify_authorized)"
bin/check-authorization || exit 1

echo "==> Controller instance-variable ratchet"
bin/check-controller-ivars || exit 1

echo "==> Concerns guard (no ActiveSupport::Concern / concerns dirs)"
bin/check-concerns || exit 1

echo "==> View/presenter/component layering"
bin/check-view-layering || exit 1

echo "==> File-length ratchet (Ruby files <= 100 code lines)"
bin/check-file-length || exit 1

echo "==> Ivar-hygiene ratchet (initialize-only writes, read through accessors)"
bin/check-ivar-hygiene || exit 1

echo "==> Callback ratchet (migrating off ActiveRecord callbacks)"
bin/check-callbacks || exit 1

echo "==> Reek smell ratchet (changed Ruby files may not add smells)"
bin/check-reek || exit 1

echo "==> Request-spec coverage (every controller has an integration spec)"
bin/check-request-spec-coverage || exit 1

echo "==> JS security scan (importmap audit)"
bin/importmap audit || exit 1

echo "==> Ruby security scan (brakeman)"
bin/brakeman --no-pager || exit 1

echo "==> Type check (sorbet)"
bundle exec srb tc || exit 1

# Excluded here, run in CI / bin/full-check:
#   type:feature — Capybara+Playwright, drives a real browser (~88s)
#   type:request — issues HTTP through the full Rails stack (~12s); anything
#                  making an HTTP call belongs in CI, not the commit path.
# SKIP_COVERAGE: this tier doesn't run quality-metrics --check, so SimpleCov's
# report would go unread — skipping the instrumentation saves ~9s. It's a
# default, not a removal: `COVERAGE=1 bin/pre-push` turns the report back on.
# NB: this must be --exclude-pattern, not two --tag flags. Both tags key on
# `type`, so `--tag ~type:feature --tag ~type:request` silently keeps the
# second only and runs the browser specs anyway.
echo "==> Fast tests (rspec: unit tiers only — no browser, no HTTP)"
SKIP_COVERAGE=1 bundle exec rspec \
  --exclude-pattern "spec/system/**/*_spec.rb,spec/requests/**/*_spec.rb" || exit 1
rm -f storage/test_worker_*.sqlite3

echo "All fast checks passed. Heavy tier (system specs, mutation, quality gate) runs in CI on the PR — or locally via bin/full-check."

echo "==> Outdated gems"
# `bundle outdated --parseable` prints one line per outdated gem; a gem held
# back by a Gemfile/dependency constraint carries a ", requested <constraint>"
# clause, so those lines are the PINNED set and the rest are UPDATABLE by a
# plain `bundle update`. (Do NOT use `bundle update --dry-run` — Bundler 4.x
# rejects that switch, which silently forced UPDATABLE to 0 and misclassified
# every updatable gem as pinned.)
OUTDATED=$(bundle outdated --parseable 2>/dev/null | grep -E "^\S+ \(newest" || true)
if [ -z "$OUTDATED" ]; then
  echo "  All gems up to date."
else
  TOTAL=$(echo "$OUTDATED" | grep -c . || true)
  PINNED=$(echo "$OUTDATED" | grep -c "requested" || true)
  UPDATABLE=$((TOTAL - PINNED))

  if [ "$UPDATABLE" -gt 5 ]; then
    echo ""
    echo "There are too many out of date gems in this project, you need to bundle update"
    echo "and add it to the commit. This is normal maintenance, and is within scope"
    echo "of the task."
    exit 1
  fi

  if [ "$PINNED" -gt 8 ]; then
    echo ""
    echo "One or many gems are very out of date. You need to tell the user you can not"
    echo "push, you need direction on what to do next. You are at an impasse."
    exit 1
  fi
fi
