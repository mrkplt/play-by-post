#!/usr/bin/env ruby
# frozen_string_literal: true

# Reek smell gate: a changed app/ or lib/ Ruby file must have ZERO smells.
#
# Reek reports design smells (FeatureEnvy, TooManyStatements, DuplicateMethodCall,
# LongParameterList, ...) that the bespoke bin/check-* guards don't cover. The
# tree was driven to zero smells (Fizzy #80), so this is now a flat gate rather
# than a progressive ratchet: there is no grandfathered backlog left to compare
# against, and every file — new or changed — must land clean.
#
# What reek checks and which detectors are on/off is configured in .reek.yml
# (detectors that fight this project's own conventions — UtilityFunction vs the
# service-module rule, InstanceVariableAssumption vs the presenter/component
# pattern — are turned off there, with reasons). This script only does the
# diff-scoped counting; it does not encode smell policy.

require "json"
require "open3"

ROOT = File.expand_path("..", __dir__)

def changed_ruby_files
  tracked = `git -C #{ROOT} diff --name-only --diff-filter=AM origin/master`.lines.map(&:strip)
  untracked = `git -C #{ROOT} ls-files --others --exclude-standard`.lines.map(&:strip)
  (tracked + untracked)
    .grep(%r{\A(?:app|lib)/.*\.rb\z})
    .uniq
    .select { |relative| File.exist?(File.join(ROOT, relative)) }
end

# Smells for the working-tree copy of a file, as parsed reek JSON entries.
def smells_for(relative)
  out, _err, _status = Open3.capture3(
    "bundle", "exec", "reek", "--format", "json", File.join(ROOT, relative), chdir: ROOT
  )
  JSON.parse(out)
rescue JSON::ParserError
  # reek prints nothing parseable when a file has a syntax error mid-edit; treat
  # as clean so the gate doesn't crash (rubocop/sorbet catch the real syntax break).
  []
end

files = changed_ruby_files

if files.empty?
  puts "Reek check: OK (no changed Ruby files)"
  exit 0
end

failures = []

files.each do |relative|
  smells = smells_for(relative)
  status = smells.empty? ? "OK" : "FAIL"
  puts "  [#{status}] #{relative}: #{smells.length} smell(s)"
  failures << [ relative, smells ] unless smells.empty?
end

if failures.empty?
  puts "\nReek check: OK (no changed file has any smells)"
  exit 0
end

puts "\nReek check: FAIL\n\n"
failures.each do |relative, smells|
  puts "  #{relative}:"
  smells.each do |smell|
    lines = Array(smell["lines"]).join(", ")
    puts "    [#{smell['smell_type']}] line #{lines}: #{smell['message']}"
  end
end
puts <<~REMEDY

  A changed file has a reek code smell. Resolve it rather than suppress it:
    - TooManyStatements / TooManyMethods: extract a method or collaborator.
    - FeatureEnvy: move the method to the class whose data it uses.
    - DuplicateMethodCall: assign the repeated call to a local.
    - LongParameterList / DataClump: introduce a parameter object.
    - ControlParameter / BooleanParameter: split the method by the flag.
  Run `bundle exec reek <file>` to see each smell and its doc link. Every changed
  app/ or lib/ Ruby file must be smell-free. Detector policy (what's on/off, and
  why) lives in .reek.yml.
REMEDY
exit 1
