#!/usr/bin/env ruby
# typed: true
# frozen_string_literal: true

# Symbolic verifier for our Pundit policy pattern.
#
#   bin/verify-policies [path/to/policy.rb ...]
#
# With no arguments, verifies every policy in app/policies. Encodes each public
# boolean predicate into a propositional formula over leaf facts and reports:
#   * FINDINGS  — reachable states worth a human's judgement (grants that rely
#                 on an unstated invariant; predicates documented as equivalent
#                 that disagree). No domain axioms are assumed.
#   * REFUSALS  — public methods outside the boolean-predicate contract (these
#                 are the convention violations to look at).
#
# The verifier is only trustworthy because spec/pundit_symbolic/faithfulness_spec.rb
# proves each formula agrees with the real Ruby method on every input.

lib = File.expand_path("../lib", __dir__)
$LOAD_PATH.unshift(lib) unless $LOAD_PATH.include?(lib)

require "sorbet-runtime"
require "pundit_symbolic/verifier"
require "pundit_symbolic/policy_registry"

# Documented equivalences per policy: predicates the source says ask "the same
# question". Extend as policies are added.
EQUIVALENCES = {
  "GamePolicy" => [ %w[show? view?], %w[manage_players? view?], %w[export? view?] ],
  "UserProfilePolicy" => [ %w[show? update?], %w[show? manage?] ]
}.freeze

# Load the whole policy dir through the registry so cross-policy delegation
# resolves. When given explicit ARGV paths, still load the full dir for context
# (a target policy must be present to resolve a marker) but report only the
# requested files.
policies_dir = File.expand_path("../app/policies", __dir__)
registry = PunditSymbolic::PolicyRegistry.load_dir(policies_dir)
requested = ARGV.empty? ? nil : ARGV.map { |p| File.basename(p) }

total_findings = 0
registry.sources.each do |source|
  basename = "#{source.policy_name.gsub(/([a-z])([A-Z])/, '\1_\2').downcase}.rb"
  next if requested && !requested.include?(basename)

  result = PunditSymbolic::Verifier.new(source, equivalences: EQUIVALENCES.fetch(source.policy_name, [])).verify

  puts "\n=== #{result[:policy]} (#{basename}) ==="
  if result[:findings].any?
    total_findings += result[:findings].size
    result[:findings].each do |finding|
      witness = finding.model.select { |_, value| value }.keys.sort.join(", ")
      puts "  FINDING [#{finding.kind}] #{finding.description}"
      puts "          witness: #{witness.empty? ? '(all false)' : witness} = true"
    end
  else
    puts "  no findings"
  end

  result[:refusals].each do |refusal|
    marker = refusal[:public] ? "PUBLIC" : "private"
    puts "  REFUSED (#{marker}) #{refusal[:name]}: #{refusal[:reason]}"
  end
end

puts "\n#{total_findings} finding(s) across #{registry.sources.size} policy file(s)."
